---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  /** Pages without a dark hero directly under the header (e.g. Contact) need the header solid from load - it otherwise renders transparent-over-nothing, which is unreadable on a light page. */
  headerAlwaysSolid?: boolean;
}

const { title, description, canonical, noindex, headerAlwaysSolid = false } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={noindex}>
  <Header alwaysSolid={headerAlwaysSolid} />
  <main id="main">
    <slot />
  </main>
  <Footer />
</BaseLayout>
