---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/base.css";
// Preloaded below so the browser fetches it immediately instead of only
// discovering it after parsing fonts.css - shortens the fallback-to-
// Archivo flash (font-display: swap) rather than removing it outright.
// Only the latin subset, matching what every page on this site actually
// uses (see fonts.css's own note on subsetting).
import archivoLatinWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoLatinWoff2}
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Page-specific head tags (e.g. the ad landing page's Meta Pixel). -->
    <slot name="head" />

    <!--
      Synchronous, blocking, and deliberately tiny - runs before first
      paint so the reveal-hiding CSS below (scoped under .js-motion)
      never has a chance to flash content before hiding it. If this
      script doesn't run at all (JS disabled) or the visitor has
      prefers-reduced-motion set, .js-motion is never added and every
      [data-reveal*] element simply stays in its default, fully-visible
      state - the scroll-reveal system is pure progressive enhancement,
      never a requirement for content to appear.
    -->
    <script is:inline>
      if (
        !window.matchMedia ||
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("js-motion");
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      // Site-wide scroll-reveal: any element carrying data-reveal,
      // data-reveal-group, or data-reveal-media is observed once and
      // gets .is-visible added the first time it nears the viewport -
      // never re-hidden on scroll back up. rootMargin extends the
      // trigger zone 200px past the bottom of the viewport so reveals
      // are already underway (often finished) by the time an element
      // is actually scrolled into view, which is what keeps fast
      // scrolling from ever feeling like it's waiting on the page.
      if (document.documentElement.classList.contains("js-motion")) {
        const targets = document.querySelectorAll<HTMLElement>(
          "[data-reveal], [data-reveal-group], [data-reveal-media]"
        );

        if (targets.length && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0, rootMargin: "0px 0px 200px 0px" }
          );

          targets.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
