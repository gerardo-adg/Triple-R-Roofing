---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/reset.css";
import "../styles/base.css";
// Preloaded below so the browser fetches it immediately instead of only
// discovering it after parsing fonts.css - shortens the fallback-to-
// Archivo flash (font-display: swap) rather than removing it outright.
// Only the latin subset, matching what every page on this site actually
// uses (see fonts.css's own note on subsetting).
import archivoLatinWoff2 from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site);

// Client's Meta Pixel (Events Manager -> Data sources). Site-wide as of
// this change - previously only loaded on the /free-estimate ad funnel
// via LandingLayout, which now relies on this copy instead of carrying
// its own (firing only its own extra, more specific event in addition
// to the PageView this one already tracks - see that layout's own
// comment). Loads on every page, noindex ones included, since the goal
// is a fuller picture of real visitor behavior, not just ad traffic.
const META_PIXEL_ID = "2460801741112237";

// Every value here is either client-confirmed directly (phone, license
// number, hours, the 4.8/95 Google figure) or structural (name/url) -
// nothing invented. No street address or sameAs/social links yet since
// neither has been provided - omitted rather than guessed; add both
// once the client gives them. Rendered site-wide (not per-page) since
// it describes the one business, not the current page.
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "RoofingContractor",
  name: "Triple R Roofing",
  url: Astro.site?.toString(),
  image: new URL("/favicon-512.png", Astro.site).toString(),
  telephone: "+19164205635",
  areaServed: "Sacramento, CA and surrounding areas",
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "06:00",
    closes: "19:00",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: "95",
    bestRating: "5",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoLatinWoff2}
      crossorigin
    />
    <!--
      Warms up the connection to Mux's servers before the hero video's own
      script even runs, so the DNS lookup/TLS handshake isn't sitting on
      the critical path of its first request. Harmless on pages with no
      video - an unused preconnect is just dropped after a few seconds.
    -->
    <link rel="preconnect" href="https://stream.mux.com" crossorigin />
    <link rel="preconnect" href="https://image.mux.com" crossorigin />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/og-image.jpg", Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.jpg", Astro.site).toString()} />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

    {META_PIXEL_ID && (
      <script is:inline define:vars={{ META_PIXEL_ID }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', META_PIXEL_ID);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- Page-specific head tags (e.g. the ad landing page's extra Lead event, fired after the PageView above). -->
    <slot name="head" />

    <!--
      Synchronous, blocking, and deliberately tiny - runs before first
      paint so the reveal-hiding CSS below (scoped under .js-motion)
      never has a chance to flash content before hiding it. If this
      script doesn't run at all (JS disabled) or the visitor has
      prefers-reduced-motion set, .js-motion is never added and every
      [data-reveal*] element simply stays in its default, fully-visible
      state - the scroll-reveal system is pure progressive enhancement,
      never a requirement for content to appear.
    -->
    <script is:inline>
      if (
        !window.matchMedia ||
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        document.documentElement.classList.add("js-motion");
      }
    </script>
  </head>
  <body>
    {META_PIXEL_ID && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
        />
      </noscript>
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      // Site-wide scroll-reveal: any element carrying data-reveal,
      // data-reveal-group, or data-reveal-media is observed once and
      // gets .is-visible added the first time it nears the viewport -
      // never re-hidden on scroll back up. rootMargin extends the
      // trigger zone 200px past the bottom of the viewport so reveals
      // are already underway (often finished) by the time an element
      // is actually scrolled into view, which is what keeps fast
      // scrolling from ever feeling like it's waiting on the page.
      if (document.documentElement.classList.contains("js-motion")) {
        const targets = document.querySelectorAll<HTMLElement>(
          "[data-reveal], [data-reveal-group], [data-reveal-media]"
        );

        if (targets.length && "IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              }
            },
            { threshold: 0, rootMargin: "0px 0px 200px 0px" }
          );

          targets.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
