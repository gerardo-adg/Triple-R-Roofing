---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import Button from "../components/Button.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import contactPhoto from "../assets/media/photo-contact-tile-repair.jpg";

// Netlify Forms detects this form at deploy time from the static HTML
// (data-netlify + the hidden form-name field) - no backend code needed
// here. Honeypot field name matches netlify-honeypot below. Actual
// submission notifications (who gets emailed) are configured in the
// Netlify dashboard after deploy, not in code - see the note left for
// the user in this session's reply.
// Matches the Services hub/navigation's exact grouping and naming, so
// this list never drifts from what's live elsewhere on the site.
// Rendered as native <optgroup>s - a real, accessible grouping
// mechanism (not a fake/non-selectable option), with no change to the
// select field's own visual styling.
const SERVICE_GROUPS = [
  {
    name: "Roofing",
    items: ["Roof Replacement", "Roof Repair", "Tile Roofing", "Flat Roofing"],
  },
  {
    name: "Roof Care",
    items: [
      "Roof Maintenance & Leak Prevention",
      "Roof Rejuvenation",
      "Roof Certifications",
      "Moss Removal",
    ],
  },
  {
    name: "Gutters",
    items: ["Gutters"],
  },
  {
    name: "Solar",
    items: ["Solar Panel Cleaning", "Roofing + Solar"],
  },
];
---

<InteriorLayout
  title="Contact | Triple R Roofing"
  description="Request a free roofing or gutter estimate in Sacramento, CA. Call (916) 420-5635 or fill out the form to get started."
  headerAlwaysSolid
>
  <section class="contact-hero">
    <div class="contact-hero__form-panel">
      <div class="contact-hero__form-inner">
        <nav class="contact-hero__breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Contact</span>
        </nav>

        <p class="eyebrow">Contact</p>
        <h1 class="contact-hero__headline">Request a free estimate.</h1>
        <p class="contact-hero__lead">
          Tell us what you need help with and we&rsquo;ll follow up to
          schedule a time to take a look.
        </p>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thank-you"
          class="contact-form"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="contact-form__honeypot" aria-hidden="true">
            <label>
              Leave this field blank
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div class="contact-form__field contact-form__field--full">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
            </div>

            <div class="contact-form__field">
              <label for="email">Email (optional)</label>
              <input id="email" name="email" type="email" inputmode="email" autocomplete="email" />
            </div>
          </div>

          <div class="contact-form__field contact-form__field--full">
            <label for="address">Property Address</label>
            <input
              id="address"
              name="address"
              type="text"
              autocomplete="street-address"
              required
            />
          </div>

          <div class="contact-form__field contact-form__field--full">
            <label for="service">Service Needed</label>
            <select id="service" name="service" required>
              <option value="" disabled selected>Select one</option>
              {SERVICE_GROUPS.map((group) => (
                <optgroup label={group.name}>
                  {group.items.map((item) => <option value={item}>{item}</option>)}
                </optgroup>
              ))}
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="contact-form__field contact-form__field--full">
            <label for="details">Message (optional)</label>
            <textarea id="details" name="details" rows="3"></textarea>
          </div>

          <Button variant="primary" type="submit" class="contact-form__submit">
            Request Estimate &rarr;
          </Button>
        </form>
      </div>
    </div>

    <div class="contact-hero__aside-panel section--inverse">
      <div class="contact-hero__aside-inner">
        <p class="eyebrow">Prefer to call?</p>
        <a href="tel:+19164205635" class="contact-hero__phone">(916) 420-5635</a>

        <div class="contact-hero__trust-divider" aria-hidden="true"></div>

        <ul class="contact-hero__trust">
          <li>Licensed, bonded &amp; insured</li>
          <li><span class="contact-hero__star" aria-hidden="true">&#9733;</span> 4.8 Google rating</li>
          <li>Serving Sacramento and surrounding areas</li>
        </ul>
      </div>

      <div class="contact-hero__photo">
        <ResponsiveImage
          src={contactPhoto}
          alt="A Triple R Roofing crew member repairing a tile roof."
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          loading="lazy"
        />
        <div class="contact-hero__photo-scrim" aria-hidden="true"></div>
      </div>
    </div>
  </section>
</InteriorLayout>

<style>
  /* ---- Split composition - one full-width section, two edge-to-edge
     panels (cream form / dark aside), not two floating cards. Stacked
     (form, then aside+photo) below 1024px - see the min-width override
     for the side-by-side split. `margin-top` (not padding) clears the
     fixed header so there's no gap in either panel's own background
     above it. ---- */
  .contact-hero {
    display: grid;
    grid-template-columns: 1fr;
    /* Mobile-only value - reset to the original (space-6) at 1024px below,
       so desktop spacing is untouched. */
    margin-top: calc(var(--nav-height) + var(--space-4));
  }

  .contact-hero__form-panel {
    background: var(--color-bg);
  }

  .contact-hero__form-inner {
    max-width: 600px;
    padding: var(--space-6) var(--container-padding) var(--space-7);
    margin-inline: auto;
  }

  /* Desktop-only: ~13% wider than the base 600px cap - the form read
     slightly too narrow within its column. Mobile/tablet stacked layout
     keeps the base 600px, which was never the issue (that's already
     nearly the full viewport width there). */
  @media (min-width: 1024px) {
    .contact-hero {
      margin-top: calc(var(--nav-height) + var(--space-6));
    }

    .contact-hero__form-inner {
      max-width: 680px;
    }
  }

  .contact-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .contact-hero__breadcrumb a {
    color: var(--color-text-muted);
  }

  .contact-hero__breadcrumb a:hover {
    color: var(--color-accent-strong);
  }

  .contact-hero__breadcrumb [aria-current] {
    color: var(--color-accent-strong);
  }

  .contact-hero__headline {
    font-size: var(--text-h2);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .contact-hero__lead {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
    max-width: 46ch;
    margin-bottom: var(--space-5);
  }

  /* ---- Form ---- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* Visible to bots, hidden from sighted users and skipped by
     keyboard/AT - Netlify's spam-filtering convention. */
  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  /* Phone/email go two-up as soon as there's room for it, independent of
     the 1024px breakpoint where the full split layout kicks in - a
     tablet-width viewport still in the stacked mobile layout shouldn't
     have to wait for that to make better use of its width. */
  @media (min-width: 700px) {
    .contact-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-form__field label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* Proper visible boxes (white fill, full border) rather than the
     underline-only fields this page used to have - reads as more
     designed/compact and makes each field's tap target obvious on
     mobile, not just its bottom edge. */
  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-none);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .contact-form__field input:focus-visible,
  .contact-form__field select:focus-visible,
  .contact-form__field textarea:focus-visible {
    border-color: var(--color-accent-strong);
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 72px;
  }

  .contact-form__submit {
    width: 100%;
    justify-content: center;
    margin-top: var(--space-2);
  }

  /* ---- Aside panel (dark) ---- */
  .contact-hero__aside-panel {
    display: flex;
    flex-direction: column;
  }

  .contact-hero__aside-inner {
    padding: var(--space-8) var(--container-padding);
  }

  /* Mobile/tablet-only: the scrim on the photo below already reads as
     black for roughly its own top third, so this padding was stacking
     with that to create a much bigger dead-black zone than the raw CSS
     gap alone suggested. Reset to the original space-8 at 1024px so
     desktop (which uses a completely different, already-approved
     50/50 flex split) is untouched. */
  @media (max-width: 1023px) {
    .contact-hero__aside-inner {
      padding-bottom: 0;
    }
  }

  .contact-hero__phone {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h4);
    color: var(--color-text-inverse);
    margin-top: var(--space-3);
  }

  .contact-hero__phone:hover {
    color: var(--color-accent);
  }

  .contact-hero__trust-divider {
    width: 100%;
    height: 1px;
    background: var(--color-border-inverse);
    margin-top: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .contact-hero__trust {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-muted-inverse);
  }

  .contact-hero__star {
    color: var(--color-gold);
  }

  /* Fixed aspect ratio on mobile (stacked flow has no shared-height
     context to fill); becomes a flex-filled remainder of the panel's
     height at desktop instead - see the min-width override below.
     `max-height` matters here because the stacked layout runs all the
     way up to 1024px (tablet widths, not just phones) - at 4:3 alone, a
     1000px-wide tablet viewport scaled this to 750px tall, a huge
     vertical block. Capping it keeps the crop close to 4:3 at real phone
     widths (390px wide -> 293px tall, barely affected) while stopping it
     from ballooning at wider stacked widths; object-fit: cover on the
     image (below) absorbs the resulting crop difference at those wider
     sizes. Reset to none at desktop, where sizing is flex-driven instead
     - see the min-width override below. */
  .contact-hero__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 280px;
    overflow: hidden;
    /* A small deliberate pause before the photo's own scrim takes over
       the rest of the transition - not a separate dead-space layer on
       top of it. Desktop fully overrides this to 0 regardless (see the
       min-width block below), so tightening this mobile value doesn't
       touch it. */
    margin-top: var(--space-2);
  }

  .contact-hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Blends the photo into the panel instead of reading as a separate
     inset image card - fades from the panel's own background color at
     the top edge down to transparent. */
  .contact-hero__photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--color-charcoal) 0%, rgb(10 10 10 / 0%) 35%);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .contact-hero {
      grid-template-columns: 55fr 45fr;
      align-items: stretch;
    }

    .contact-hero__form-inner {
      margin-inline: 0;
      padding-inline-start: var(--container-padding);
      padding-inline-end: var(--space-7);
    }

    .contact-hero__aside-panel {
      height: 100%;
    }

    .contact-hero__aside-inner {
      padding-inline: var(--space-8);
      /* Natural content height, not a forced 50/50 split - an equal
         flex-grow here was stretching this box far past the trust
         content's actual height (it's much shorter than half the panel),
         which is what created the oversized dead zone below the text
         (measured ~336px of empty space within this box alone, before
         the photo even starts). A negative margin on the photo doesn't
         cleanly claw that back either: with both items sharing
         flex-grow, pulling the photo up just freed space that aside-inner
         itself grew into, so only about half of any pull-up ever showed
         up as real movement. Fixed height + an explicit bottom padding
         below is a direct, predictable substitute for both - this value
         is the entire gap (the photo's own margin-top is reset to 0 just
         below, rather than left to inherit the mobile-only spacing rule).
         Cut further (182px -> 90px) in the compacting pass: still a real,
         intentional pause, but well under half the previous gap. */
      flex: 0 0 auto;
      padding-bottom: 90px;
    }

    .contact-hero__trust-divider {
      max-width: 320px;
    }

    /* Absorbs 100% of the panel's remaining height (aside-inner no longer
       grows), so the photo reliably reaches the panel's own bottom/right
       edges - the gap above it is exactly aside-inner's padding-bottom,
       not an emergent flex-redistribution result. flex-basis must stay 0
       (not auto): auto would let the real photo's own natural (portrait,
       tall) rendered height count toward the panel's intrinsic size
       before grid's stretch ever applies, inflating the whole right
       panel past the form panel's height instead of matching it. */
    .contact-hero__photo {
      flex: 1 1 0;
      aspect-ratio: auto;
      max-height: none;
      min-height: 320px;
      margin-top: 0;
    }
  }
</style>
