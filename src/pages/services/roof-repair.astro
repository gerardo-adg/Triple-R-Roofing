---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PageHero from "../../components/PageHero.astro";
import PhotoBand from "../../components/PhotoBand.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import ServiceCoverageList from "../../components/ServiceCoverageList.astro";
import CertificationsSection from "../../components/CertificationsSection.astro";
import FinancingCallout from "../../components/FinancingCallout.astro";
import FAQSection from "../../components/FAQSection.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import pageHeroImage from "../../assets/media/placeholder-page-hero-repair.svg";
import detailImage from "../../assets/media/placeholder-detail-roof-repair.svg";
import gafLogo from "../../assets/media/cert-gaf-certified-plus.png";
import certainteedLogo from "../../assets/media/cert-certainteed-select-shinglemaster.png";
import owensCorningLogo from "../../assets/media/cert-owens-corning-preferred-contractor.png";
import ascLogo from "../../assets/media/cert-asc-certified-contractor.png";
import bbbLogo from "../../assets/media/cert-bbb-accredited-business.png";

// Real jobsite footage: a Triple R crew member on an active roof,
// patching a leak and explaining the repair as it happens. Not a
// talking-head clip - this fills the "Recent work" slot that was
// already reserved on this page (previously a placeholder photo,
// per MEDIA_PLAN.md's tier system: a photo there normally uses
// ServiceProjectSpotlight, but that shared component is built
// full-bleed at 16:9 and is also used by Roof Replacement, Tile
// Roofing, and Gutters - stretching a 9:16 video into that treatment
// would render absurdly tall, and modifying the shared component would
// affect those other pages. This page uses its own contained "Recent
// work" section instead, so ServiceProjectSpotlight and the other
// pages using it are untouched. Client-confirmed poster frame.
const REPAIR_VIDEO_MUX_ID = "tyzo1wJhg8kM1ktkrpswjEBF00D02umT2p3cCLOZ24U8I";
const REPAIR_VIDEO_POSTER = `https://image.mux.com/${REPAIR_VIDEO_MUX_ID}/thumbnail.jpg?time=2`;

// Problem descriptions are drafted generically (standard, widely-true
// roofing knowledge) rather than sourced from the client - not yet
// confirmed as matching how Triple R specifically describes these
// issues. Flagged for confirmation before treated as final.
const COVERAGE = [
  {
    name: "Roof leaks",
    description:
      "Water getting in around a specific point, usually where the roofing meets something else, like a vent, chimney, or valley.",
  },
  {
    name: "Missing or damaged shingles",
    description:
      "Shingles that have come loose, cracked, or blown off, leaving the layer underneath exposed.",
  },
  {
    name: "Flashing problems",
    description:
      "The metal or sealant around chimneys, vents, and roof edges failing or coming loose, a common source of leaks.",
  },
  {
    name: "Storm damage",
    description: "Wind, hail, or fallen debris affecting part of the roof rather than the whole thing.",
  },
  {
    name: "Vent and pipe boot leaks",
    description: "The rubber or metal seals around roof vents and pipes cracking or wearing out over time.",
  },
];

// Verified (Trust section, Phase 1 audit / client-confirmed copy), plus
// Owens Corning and ASC (American Standard Coatings) added directly from
// the client's own certification badges. Owens Corning/ASC descriptions
// are deliberately conservative - researched against independent
// roofing-industry sources (their own program pages were unreachable to
// verify directly), so specifics like exact warranty terms are left out
// rather than stated as fact.
const CREDENTIALS = [
  {
    name: "GAF Certified Plus",
    description: "Certified Plus Residential Roofing Contractor through GAF.",
    logo: gafLogo,
  },
  {
    name: "CertainTeed SELECT ShingleMaster",
    description: "CertainTeed's SELECT ShingleMaster credential.",
    logo: certainteedLogo,
  },
  {
    name: "Owens Corning Preferred Contractor",
    description:
      "Recognized by Owens Corning as a Preferred Contractor for meeting their standards for licensing, insurance, and installation quality.",
    logo: owensCorningLogo,
  },
  {
    name: "ASC Certified Contractor",
    description:
      "Certified by American Standard Coatings as a trained applicator of their roof coating and restoration systems.",
    logo: ascLogo,
  },
  {
    name: "BBB Accredited",
    description: "Accredited by the Better Business Bureau.",
    logo: bbbLogo,
  },
];

// FAQ answers are limited to verified or already-established facts.
// Response time wording below is client-confirmed for this page; do not
// change it to a guaranteed "same-day" claim.
const FAQS = [
  {
    question: "Is this a repair, or do I need a full replacement?",
    answer:
      "It depends on what we find. Isolated damage, like one damaged section or a single leak, is usually a repair. Widespread wear or damage across multiple areas may mean a replacement makes more sense. We inspect first and tell you which one applies before recommending anything.",
  },
  {
    question: "Are you licensed and insured?",
    answer:
      "Yes. We're licensed, bonded, and insured, and a GAF Certified and CertainTeed SELECT ShingleMaster contractor.",
  },
  {
    question: "Do you offer free estimates?",
    answer: "Yes. Call or request one online and we'll schedule a time to come look at your roof.",
  },
  {
    question: "How quickly can someone look at my roof?",
    answer:
      "Same-day service may be available if the schedule allows. Otherwise, we'll schedule the next available appointment.",
  },
];
---

<InteriorLayout
  title="Roof Repair | Triple R Roofing"
  description="Roof repair for leaks, damaged shingles, flashing problems, and storm damage in Sacramento. Licensed, bonded, and insured, GAF Certified and CertainTeed SELECT ShingleMaster."
>
  <PageHero
    title="Roof Repair"
    description="Leaks, damaged shingles, flashing issues, and other isolated roof problems, fixed without a full replacement."
    image={pageHeroImage}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: "Roof Repair" },
    ]}
  />

  <section class="overview">
    <Container>
      <div class="overview__content" data-reveal>
        <p class="eyebrow">Roof Repair</p>
        <h2 class="overview__headline">
          A leak doesn&rsquo;t always mean you need a new roof.
        </h2>
        <p class="overview__body">
          Some roof problems are isolated: a cracked shingle, a failed seal
          around a vent, storm damage to one section. Those can usually be
          repaired without touching the rest of the roof.
        </p>
        <p class="overview__body">
          Other problems are more widespread and may not make sense to keep
          patching. We inspect the roof first and tell you what we find,
          rather than assuming it needs to be replaced.
        </p>
      </div>
    </Container>
  </section>

  <PhotoBand
    image={detailImage}
    imageAlt=""
  />

  <ServiceCoverageList
    eyebrow="What we fix"
    headline="Roof problems we repair."
    items={COVERAGE}
  />

  <section class="repair-video">
    <Container>
      <div class="repair-video__intro" data-reveal>
        <p class="eyebrow">Recent work</p>
        <h2 class="repair-video__headline">Patching a roof leak.</h2>
        <p class="repair-video__body">
          See how the Triple R crew handles a roof leak repair on site.
        </p>
      </div>

      <div class="repair-video__frame" data-reveal-media>
        <PlayableVideo
          poster={REPAIR_VIDEO_POSTER}
          alt="A Triple R crew member patches a roof leak on an active job."
          aspectRatio="9 / 16"
          muxPlaybackId={REPAIR_VIDEO_MUX_ID}
        />
      </div>
    </Container>
  </section>

  <CertificationsSection
    eyebrow="Materials & Certifications"
    headline="Backed by the brands behind the roof."
    intro="Triple R Roofing holds certifications from GAF, CertainTeed, Owens Corning, and ASC, and is accredited by the Better Business Bureau."
    credentials={CREDENTIALS}
  />

  <FinancingCallout />

  <FAQSection
    eyebrow="Common Questions"
    headline="Roof repair, answered"
    groupName="faq-roof-repair"
    items={FAQS}
  />

  <FinalCtaSection
    headline="Let's take a look at your roof."
    body="We'll take a look at the problem and explain what we find."
  />
</InteriorLayout>

<style>
  .overview {
    padding-block: var(--space-9);
  }

  .overview__content {
    max-width: 720px;
  }

  .overview__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .overview__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
  }

  /* ---- Recent work video - replaces this page's ServiceProjectSpotlight
     placeholder with a contained (not full-bleed) 9:16 frame, since that
     shared component is built for full-bleed 16:9 photos and is also
     used by other service pages. Sized and composed the same way as the
     Roof Maintenance page's video section for consistency. ---- */
  .repair-video {
    padding-block: var(--space-9);
    /* Mobile-only: ServiceCoverageList's own bottom padding plus this
       section's top padding (96px + 96px) left an oversized gap above
       this heading on narrow screens - same fix as Roof Replacement's
       deck-video section, using the same tuned -60px (a full -96px
       reduction read too tight there once actually shown on-device).
       Reset back to 0 on desktop below, where the two paddings already
       read fine together. */
    margin-top: -60px;
    text-align: center;
  }

  .repair-video__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .repair-video__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .repair-video__body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }

  .repair-video__frame {
    margin-top: var(--space-8);
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .repair-video {
      padding-block: var(--space-8);
      margin-top: 0;
    }

    .repair-video__frame {
      max-width: clamp(380px, 30vw, 430px);
    }
  }
</style>
