---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceTriad from "../../components/ServiceTriad.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import FinancingCallout from "../../components/FinancingCallout.astro";
import FAQSection from "../../components/FAQSection.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import pageHeroImage from "../../assets/media/placeholder-page-hero-tile.svg";
import overviewImage from "../../assets/media/photo-tile-roof-tearoff-crew.jpg";

// Real drone footage of a Triple R tile roofing job, replacing the old
// photo-placeholder ServiceProjectSpotlight slot - contained (not
// full-bleed) 16:9, same pattern as Roof Replacement's North Highlands
// drone video. Client-confirmed poster frame (time=15) and location
// (Sacramento, CA).
const TILE_VIDEO_MUX_ID = "KnMcBpUJ6oGWLYkFe01BIOSwHQstRnvJkK02lJLSqDAMs";
const TILE_VIDEO_POSTER = `https://image.mux.com/${TILE_VIDEO_MUX_ID}/thumbnail.jpg?time=15`;

// Confirmed directly by the client: Triple R does tile roof repair, tile
// resets (lift and relay), and full tile roof replacement, for both
// concrete and clay tile. No specific tile manufacturer certification
// exists, so GAF/CertainTeed (both shingle-specific credentials - see
// CertainTeed's own "SELECT ShingleMaster" name) are not presented as
// tile-roofing credentials anywhere on this page. Only the general
// licensed/bonded/insured + BBB Accredited facts are used, in the FAQ.
const SERVICES = [
  {
    name: "Tile Roof Repair",
    description: "Broken or slipped tiles, leaks, and other isolated problems.",
  },
  {
    name: "Tile Reset / Lift & Relay",
    description:
      "We remove the existing tile, address the underlayment underneath, and reinstall the tile that can still be used.",
  },
  {
    name: "Tile Roof Replacement",
    description: "When the roof needs more than a repair or reset, we can replace the full tile roof.",
  },
];

// FAQ answers are limited to verified or already-established facts. No
// lifespan, warranty, installation-process, or manufacturer claims.
const FAQS = [
  {
    question: "What's a tile reset or lift and relay?",
    answer:
      "We remove the existing tile, repair or replace the underlayment underneath it, and reinstall the tile that's still usable.",
  },
  {
    question: "How do I know which service I need?",
    answer:
      "An inspection determines that. Depending on what we find, it might be a repair, a reset, or a full replacement.",
  },
  {
    question: "Are you licensed and insured?",
    answer: "Yes. We're licensed, bonded, and insured, and BBB Accredited.",
  },
  {
    question: "Is financing available?",
    answer:
      "Yes, through Wisetack, including 0% APR for 24 months for qualified borrowers.",
  },
  {
    question: "Do you offer free estimates?",
    answer: "Yes. Call or request one online and we'll schedule a time to come look at your roof.",
  },
];
---

<InteriorLayout
  title="Tile Roofing | Triple R Roofing"
  description="Tile roof repair, resets, and replacement for concrete and clay tile roofs in Sacramento, CA. Licensed, bonded, and insured, and BBB Accredited."
>
  <PageHero
    title="Tile Roofing"
    description="Tile roof repair, resets, and replacement in Sacramento."
    image={pageHeroImage}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: "Tile Roofing" },
    ]}
  />

  <section class="overview">
    <Container>
      <div class="overview__grid">
        <div class="overview__content" data-reveal>
          <p class="eyebrow">Tile Roofing</p>
          <h2 class="overview__headline">The problem isn&rsquo;t always the tile.</h2>
          <p class="overview__body">
            The tile is what you see, but there&rsquo;s an underlayment and roof
            system underneath it. When a tile roof leaks, the issue can be
            coming from underneath the tile.
          </p>
          <p class="overview__body">
            Depending on what we find, the roof may need an isolated repair, a
            tile reset to address the underlayment, or a full replacement. We
            inspect it first and figure out which one makes sense.
          </p>
        </div>

        <div class="overview__media" data-reveal-media>
          <ResponsiveImage
            src={overviewImage}
            alt="A Triple R crew tearing off and replacing a tile roof."
            widths={[400, 600, 800, 1200]}
            sizes="(min-width: 900px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <ServiceTriad
    eyebrow="Tile Roof Services"
    headline="Three ways we can help with your tile roof."
    items={SERVICES}
  />

  <section class="tile-spotlight">
    <Container>
      <div data-reveal>
        <p class="eyebrow tile-spotlight__eyebrow">Recent work</p>
        <p class="tile-spotlight__meta">Tile Roofing &middot; Sacramento, CA</p>
      </div>

      <div class="tile-spotlight__frame" data-reveal-media>
        <PlayableVideo
          poster={TILE_VIDEO_POSTER}
          alt="Drone footage of a Triple R tile roofing project."
          aspectRatio="16 / 9"
          muxPlaybackId={TILE_VIDEO_MUX_ID}
        />
      </div>

      <p class="tile-spotlight__caption">
        Drone footage of a Triple R tile roofing job.
      </p>
    </Container>
  </section>

  <FinancingCallout />

  <FAQSection
    eyebrow="Common Questions"
    headline="Tile roofing, answered"
    groupName="faq-tile-roofing"
    items={FAQS}
  />

  <FinalCtaSection
    headline="Let's take a look at your tile roof."
    body="We'll inspect it and explain what we find."
  />
</InteriorLayout>

<style>
  .overview {
    padding-block: var(--space-9);
  }

  /* Stacked (text above photo) on mobile - matches DOM order, so no
     reordering needed there. Becomes a two-column, text-left/photo-right
     grid at desktop - see the min-width override below. */
  .overview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  .overview__content {
    max-width: 720px;
  }

  .overview__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .overview__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
  }

  .overview__media {
    aspect-ratio: 1206 / 1136;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .overview__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .overview__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }

    .overview__content {
      max-width: none;
    }
  }

  /* Mobile-only: this page's own overview section and the shared
     ServiceTriad component ("Tile Roof Services") each carry a 96px
     padding-block, stacking into an oversized gap between them - same
     issue already fixed elsewhere on the site, e.g. Roof Replacement's
     deck-video section. `:global` is needed here since ServiceTriad
     renders its own `.triad` element under its own component scope, not
     this page's - reset back to 0 on desktop, where ServiceTriad's own
     existing desktop override already tightened this gap from the other
     side (its bottom padding, not this margin). Page-local, so this
     doesn't affect ServiceTriad's other callers (Gutters, Roof
     Maintenance, Roof Rejuvenation, Flat Roofing). */
  :global(.triad) {
    margin-top: -60px;
  }

  @media (min-width: 900px) {
    :global(.triad) {
      margin-top: 0;
    }
  }

  /* ---- Recent work (video) - contained within the page's normal content
     width, same pattern as Roof Replacement's North Highlands drone
     video section. ---- */
  .tile-spotlight {
    padding-block: var(--space-9);
    /* Mobile-only: same oversized-gap issue as above, between ServiceTriad
       and this section - measured larger here than the overview->triad
       gap (ServiceTriad's grid/items carry a bit more trailing space than
       a plain padding-bottom), so this needed a bigger pull-up to land in
       the same visual range. Reset to 0 on desktop below. */
    margin-top: -120px;
  }

  .tile-spotlight__eyebrow {
    margin-bottom: var(--space-3);
  }

  .tile-spotlight__meta {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .tile-spotlight__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .tile-spotlight__caption {
    max-width: 62ch;
    margin-top: var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .tile-spotlight {
      margin-top: 0;
    }

    .tile-spotlight__frame {
      max-height: 75vh;
    }
  }
</style>
