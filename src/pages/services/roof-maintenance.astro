---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import LazyVideo from "../../components/LazyVideo.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import FinancingCallout from "../../components/FinancingCallout.astro";
import FAQSection from "../../components/FAQSection.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import droneCrewPhoto from "../../assets/media/photo-maintenance-crew-aerial.jpg";

// Real drone footage of the Triple R crew actively performing roof
// maintenance - replaces the old PhotoBand placeholder with a muted,
// looping, non-interactive background video (LazyVideo, hero={false}),
// serving as visual proof of the crew at work. This is a documented
// exception to the "only the homepage Hero autoplays" rule - see
// MEDIA_PLAN.md's Autoplay rules section. Kept separate from the
// vertical Rogelio explainer below, which remains the educational,
// click-to-play walkthrough. Poster is a real photo from the same
// maintenance job (not a Mux thumbnail), so prefers-reduced-motion
// users see actual proof of work, not a generic frame.
const MAINTENANCE_DRONE_MUX_ID = "01g2gapJoJY701aQaqOwoW66J6e3eMtL7yGAylzegUQE8";

// A third Mux video: ~1 minute, vertical, Rogelio explaining the full
// roof maintenance package - service-specific (unlike the About page's
// name-origin and team clips), so this is the only page it belongs on.
// Client-confirmed poster frame.
const MAINTENANCE_VIDEO_MUX_ID = "BCN700zAeUGNRbhLOclQI5VHVkp00se78tLqSaDyzyGgU";
const MAINTENANCE_VIDEO_POSTER = `https://image.mux.com/${MAINTENANCE_VIDEO_MUX_ID}/thumbnail.jpg?time=2`;

// A fourth Mux video: a compilation of real maintenance-visit footage
// (fixing broken tiles, cleaning valleys, patching leaks), client-
// provided. No specific job location was given, so none is named in the
// copy below. Poster frame time (6s) is client-confirmed.
const MAINTENANCE_SPOTLIGHT_MUX_ID = "Tr8ZSGT6EKwVshxnsLV2cmAvwtlZe78qngOUkjYrKWI";
const MAINTENANCE_SPOTLIGHT_POSTER = `https://image.mux.com/${MAINTENANCE_SPOTLIGHT_MUX_ID}/thumbnail.jpg?time=6`;

// Deliberately shorter and differently shaped than Roof Repair/Roof
// Replacement - only three facts are confirmed for this service (it's
// one offering, not two; the purpose is catching potential leak areas
// before they become problems; the work can include repairs/upgrades to
// roof metals and vents), so this page skips the sections that would
// otherwise need invented content to fill them: no PageHero (a bespoke
// dark statement hero instead, same move About's name-reveal already
// makes), no ServiceTriad/ServiceCoverageList list section (replaced by
// the editorial "areas" rows below, phrased so three examples don't read
// as an exhaustive checklist), no CertificationsSection (GAF/CertainTeed
// are tied to installed roofing material, not confirmed to apply here),
// no Recent Work spotlight (no real project photos confirmed yet for
// this specific service).
const AREAS = [
  {
    label: "Potential leak areas",
    description: "Areas of the roof where a leak could potentially develop.",
  },
  {
    label: "Roof metals",
    description: "Existing metal components may be repaired or upgraded as part of the service.",
  },
  {
    label: "Vents",
    description: "Areas around roof vents can also be addressed when needed.",
  },
];

// FAQ answers are limited to verified or already-established facts. No
// maintenance frequency or recurring-schedule claim - that hasn't been
// confirmed, so "it depends on your roof" is as specific as this gets.
const FAQS = [
  {
    question: "What's included in a maintenance visit?",
    answer: "It depends on your roof. It can include repairs or upgrades to your roof metals and vents.",
  },
  {
    question: "Are you licensed and insured?",
    answer: "Yes. We're licensed, bonded, and insured, and BBB Accredited.",
  },
  {
    question: "Is financing available?",
    answer:
      "Yes, through Wisetack, including 0% APR for 24 months for qualified borrowers.",
  },
  {
    question: "Do you offer free estimates?",
    answer: "Yes. Call or request one online and we'll schedule a time to come look at your roof.",
  },
];
---

<InteriorLayout
  title="Roof Maintenance & Leak Prevention | Triple R Roofing"
  description="Roof maintenance and leak prevention in Sacramento, CA - addressing potential leak areas before they become a problem."
>
  <section class="maintenance-hero section--inverse">
    <Container>
      <nav class="maintenance-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/services">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Roof Maintenance &amp; Leak Prevention</span>
      </nav>

      <p class="eyebrow">Roof Maintenance &amp; Leak Prevention</p>

      <div class="maintenance-hero__grid">
        <h1 class="maintenance-hero__headline">Before it becomes a leak.</h1>
        <p class="maintenance-hero__body">
          Roof maintenance is about catching potential leak areas before
          they become bigger problems. We look at areas that may need
          attention, including roof metals and vents, and address repairs
          or upgrades where needed.
        </p>
      </div>
    </Container>
  </section>

  <LazyVideo
    class="maintenance-drone-video"
    poster={droneCrewPhoto}
    alt="Aerial view of the Triple R crew performing roof maintenance."
    aspectRatio="16 / 9"
    muxPlaybackId={MAINTENANCE_DRONE_MUX_ID}
  />

  <section class="maintenance-areas">
    <Container>
      <div class="maintenance-areas__intro" data-reveal>
        <p class="eyebrow">Roof Maintenance</p>
        <h2 class="maintenance-areas__headline">What a visit can involve.</h2>
      </div>

      <div class="maintenance-areas__list" data-reveal-group>
        {AREAS.map((area, i) => (
          <div class="maintenance-areas__row" data-reveal-item style={`--i: ${i}`}>
            <p class="maintenance-areas__label">{area.label}</p>
            <p class="maintenance-areas__description">{area.description}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="maintenance-video">
    <Container>
      <div class="maintenance-video__intro" data-reveal>
        <p class="eyebrow">Roof Maintenance</p>
        <h2 class="maintenance-video__headline">See what a full maintenance includes.</h2>
        <p class="maintenance-video__body">
          Rogelio walks through what Triple R checks and addresses during
          a roof maintenance visit.
        </p>
      </div>

      <div class="maintenance-video__frame" data-reveal-media>
        <PlayableVideo
          poster={MAINTENANCE_VIDEO_POSTER}
          alt="Rogelio explains the full roof maintenance package."
          aspectRatio="9 / 16"
          muxPlaybackId={MAINTENANCE_VIDEO_MUX_ID}
        />
      </div>
    </Container>
  </section>

  <section class="maintenance-spotlight">
    <Container>
      <div class="maintenance-spotlight__intro" data-reveal>
        <p class="eyebrow">Recent work</p>
        <h2 class="maintenance-spotlight__headline">See the crew in action.</h2>
        <p class="maintenance-spotlight__body">
          A look at the Triple R crew fixing broken tiles, cleaning valleys,
          and patching leaks on a recent maintenance job.
        </p>
      </div>

      <div class="maintenance-spotlight__frame" data-reveal-media>
        <PlayableVideo
          poster={MAINTENANCE_SPOTLIGHT_POSTER}
          alt="The Triple R crew fixing broken tiles, cleaning valleys, and patching leaks during a roof maintenance visit."
          aspectRatio="9 / 16"
          muxPlaybackId={MAINTENANCE_SPOTLIGHT_MUX_ID}
        />
      </div>
    </Container>
  </section>

  <FinancingCallout eyebrow="Financing Available" />

  <FAQSection
    eyebrow="Common Questions"
    headline="Roof maintenance, answered"
    groupName="faq-roof-maintenance"
    items={FAQS}
  />

  <FinalCtaSection
    headline="Let's take a look at your roof."
    body="Request a free estimate and tell us what's going on with your roof."
  />
</InteriorLayout>

<style>
  /* ---- Statement hero (no PageHero - a text-only dark moment, the
     same move About's name-reveal already makes) ---- */
  .maintenance-hero {
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-10);
  }

  .maintenance-hero__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted-inverse);
    margin-bottom: var(--space-6);
  }

  .maintenance-hero__breadcrumb a {
    color: var(--color-text-muted-inverse);
  }

  .maintenance-hero__breadcrumb a:hover {
    color: var(--color-gold);
  }

  .maintenance-hero__breadcrumb [aria-current] {
    color: var(--color-gold);
  }

  .maintenance-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .maintenance-hero__headline {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-expanded);
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--color-text-inverse);
  }

  .maintenance-hero__body {
    max-width: 46ch;
    font-size: var(--text-body-lg);
    color: var(--color-text-muted-inverse);
  }

  /* Desktop only: a two-column editorial split (headline left, paragraph
     offset to the right, aligned to its bottom edge) rather than just a
     wider single column - the same "distinct at desktop, not just
     scaled up" move Financing's and FinalCta's own grids already make on
     this site, applied here to the hero instead of a stats/actions row.
     Gap is tighter than a typical two-column split (and the ratio less
     extreme) so the paragraph reads as part of the same statement, not a
     detached aside - a little more width lets it hold that weight. */
  @media (min-width: 900px) {
    .maintenance-hero__grid {
      grid-template-columns: 1.15fr 1fr;
      align-items: end;
      gap: var(--space-7);
    }

    .maintenance-hero__body {
      max-width: 50ch;
    }
  }

  /* ---- Drone maintenance footage - page-local sizing, taller than
     PhotoBand's original footprint so the aerial composition (roof and
     crew) isn't cropped down to a thin panoramic sliver. Explicit height
     at every breakpoint wins over the component's inline aspect-ratio
     style (both can't govern height at once), so this never has to
     touch the shared LazyVideo component, which is also used by the
     homepage Hero. object-fit: cover (set by the component) still
     applies, so the video is never distorted, only more of it is
     visible. Cinematic and full width, deliberately short of a
     hero-sized section. ---- */
  :global(.maintenance-drone-video) {
    background: var(--color-charcoal-raised);
    height: clamp(190px, 50vw, 230px);
  }

  @media (min-width: 700px) {
    :global(.maintenance-drone-video) {
      height: clamp(260px, 34vw, 320px);
    }
  }

  @media (min-width: 900px) {
    :global(.maintenance-drone-video) {
      height: clamp(320px, 22vw, 380px);
    }
  }

  /* ---- Editorial "areas" list - label-left / description-right rows,
     not cards or icons. A different shape from ServiceTriad's 3-column
     grid and ServiceCoverageList's stacked rows elsewhere on the site. ---- */
  .maintenance-areas {
    padding-block: var(--space-9);
  }

  .maintenance-areas__intro {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .maintenance-areas__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
  }

  .maintenance-areas__list {
    border-top: 1px solid var(--color-border);
  }

  .maintenance-areas__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .maintenance-areas__label {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h5);
  }

  .maintenance-areas__description {
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  /* Desktop only: label and description sit side by side in a fixed
     narrow/wide split - mobile keeps the stacked single column above. */
  @media (min-width: 900px) {
    .maintenance-areas__row {
      grid-template-columns: minmax(0, 280px) 1fr;
      align-items: baseline;
      gap: var(--space-8);
    }
  }

  /* ---- Maintenance video - a supporting explainer, not this page's
     central visual moment, so it stays smaller than About's family
     video and uses the same light background as the section above it
     rather than introducing a second dark moment on this page. ---- */
  .maintenance-video {
    padding-block: var(--space-9);
    text-align: center;
  }

  .maintenance-video__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .maintenance-video__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .maintenance-video__body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }

  .maintenance-video__frame {
    margin-top: var(--space-8);
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    /* Tighter block padding and a wider frame than the mobile defaults -
       the original --space-9 padding plus a 380px cap left too much
       empty vertical space around the video at desktop; still modest,
       not the page's central visual moment. */
    .maintenance-video {
      padding-block: var(--space-8);
    }

    .maintenance-video__frame {
      max-width: clamp(380px, 30vw, 430px);
    }
  }

  /* ---- Recent work (compilation video) - same contained, centered
     pattern as the Rogelio explainer directly above it (this page's
     established shape for a 9:16 video section), not Roof Replacement's
     full-bleed-width spotlight grid, since this page already established
     its own video-section rhythm. ---- */
  .maintenance-spotlight {
    padding-block: var(--space-9);
    text-align: center;
  }

  .maintenance-spotlight__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .maintenance-spotlight__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .maintenance-spotlight__body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }

  .maintenance-spotlight__frame {
    margin-top: var(--space-8);
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .maintenance-spotlight {
      padding-block: var(--space-8);
    }

    .maintenance-spotlight__frame {
      max-width: clamp(380px, 30vw, 430px);
    }
  }
</style>
