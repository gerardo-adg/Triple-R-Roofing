---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PageHero from "../../components/PageHero.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import ServiceIncludes from "../../components/ServiceIncludes.astro";
import CertificationsSection from "../../components/CertificationsSection.astro";
import FinancingCallout from "../../components/FinancingCallout.astro";
import FAQSection from "../../components/FAQSection.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import overviewImage from "../../assets/media/photo-replacement-shingle-install.jpg";
import gafLogo from "../../assets/media/cert-gaf-certified-plus.png";
import gafSilverPledgeLogo from "../../assets/media/cert-gaf-silver-pledge.png";
import certainteedLogo from "../../assets/media/cert-certainteed-select-shinglemaster.png";
import owensCorningLogo from "../../assets/media/cert-owens-corning-preferred-contractor.png";
import ascLogo from "../../assets/media/cert-asc-certified-contractor.png";
import bbbLogo from "../../assets/media/cert-bbb-accredited-business.png";

// Real jobsite footage: Rogelio explains where dry rot commonly shows
// up, then walks through a real project where the crew found
// significant dry rot that had to be repaired before the new roofing
// materials went down. Strengthens the existing "Deck inspection &
// repair" line in INCLUDES below with real proof, rather than being a
// new, unrelated section. Kept separate from the "Recent work" video
// below, which serves a different purpose (general completed-job
// proof). Client-confirmed poster frame.
const DECK_VIDEO_MUX_ID = "8gPC01BeUjsDOFpe02PUFxM00nlTYn6EKmJL3YUz01QjMMM";
const DECK_VIDEO_POSTER = `https://image.mux.com/${DECK_VIDEO_MUX_ID}/thumbnail.jpg?time=1`;

// Real drone footage of a completed roof replacement in North
// Highlands, CA - the same asset used on the Projects page's featured
// slot. Fills the "Recent work" slot this page already reserved for
// real completed-job proof, previously a placeholder photo via
// ServiceProjectSpotlight. That shared component is built for
// full-bleed 16:9 photos and is also used by Gutters and Tile Roofing;
// this landscape video actually matches its aspect ratio, but a
// page-local block (visually identical to ServiceProjectSpotlight)
// still avoids adding video support to the shared component itself,
// same approach as the Roof Repair page. Only confirmed facts used:
// no material, scope, or completion date.
const NORTH_HIGHLANDS_MUX_ID = "8G23HDzQ7IbFqq01E9wl8c7lfS9B491xkVCJ00p4Q02sQM";
const NORTH_HIGHLANDS_POSTER = `https://image.mux.com/${NORTH_HIGHLANDS_MUX_ID}/thumbnail.jpg?time=10`;

// Scope-of-work items below: only the last one ("final walkthrough,
// cleanup") is verified against the client's existing site (Phase 1
// audit). The tear-off/deck/underlayment steps are standard industry
// scope-of-work, drafted generically - not yet confirmed as matching
// Triple R's exact process. Flagged for confirmation before this copy
// is treated as final. Warranty paperwork is deliberately left out
// entirely (not just unspecified in length) until confirmed with the
// client.
const INCLUDES = [
  {
    index: "01",
    title: "Tear-off & disposal",
    description: "Full removal of the old roofing material, hauled away as part of the job.",
  },
  {
    index: "02",
    title: "Deck inspection & repair",
    description:
      "Checking the roof deck underneath for damage and replacing anything compromised before new material goes down.",
  },
  {
    index: "03",
    title: "Underlayment & flashing",
    description:
      "New underlayment and flashing around chimneys, vents, and valleys, so water has nowhere to get in.",
  },
  {
    index: "04",
    title: "New roofing installed",
    description: "Your new roofing material installed to manufacturer specification.",
  },
  {
    index: "05",
    title: "Cleanup & final walkthrough",
    description:
      "Full site cleanup and a walkthrough of the finished roof with you before we call the job done.",
  },
];

// Verified (Trust section, Phase 1 audit / client-confirmed copy), plus
// Owens Corning and ASC (American Standard Coatings) added directly from
// the client's own certification badges. Owens Corning/ASC descriptions
// are deliberately conservative - researched against independent
// roofing-industry sources (their own program pages were unreachable to
// verify directly), so specifics like exact warranty terms are left out
// rather than stated as fact.
const CREDENTIALS = [
  {
    name: "GAF Certified Plus",
    description: "Certified Plus Residential Roofing Contractor through GAF.",
    logo: gafLogo,
  },
  {
    name: "GAF Silver Pledge Limited Warranty",
    description: "GAF's Silver Pledge limited warranty, backed by a GAF Certified contractor.",
    logo: gafSilverPledgeLogo,
  },
  {
    name: "CertainTeed SELECT ShingleMaster",
    description: "CertainTeed's SELECT ShingleMaster credential.",
    logo: certainteedLogo,
  },
  {
    name: "Owens Corning Preferred Contractor",
    description:
      "Recognized by Owens Corning as a Preferred Contractor for meeting their standards for licensing, insurance, and installation quality.",
    logo: owensCorningLogo,
  },
  {
    name: "ASC Certified Contractor",
    description:
      "Certified by American Standard Coatings as a trained applicator of their roof coating and restoration systems.",
    logo: ascLogo,
  },
  {
    name: "BBB Accredited",
    description: "Accredited by the Better Business Bureau.",
    logo: bbbLogo,
  },
];

// FAQ answers are limited to verified or already-established facts.
// Deliberately not included: typical project duration, permit handling,
// disposal practices, and warranty length - none of those are verified,
// so rather than guess, they're left out of this list for now pending
// confirmation.
const FAQS = [
  {
    question: "What's the difference between a repair and a full replacement?",
    answer:
      "A repair addresses a specific, isolated issue. A full replacement starts over from the roof deck up, and makes sense when the damage or wear isn't isolated to one area. We'll tell you honestly which one your roof needs.",
  },
  {
    question: "Are you licensed and insured?",
    answer:
      "Yes. We're licensed, bonded, and insured, and a GAF Certified and CertainTeed SELECT ShingleMaster contractor.",
  },
  {
    question: "Is financing available?",
    answer:
      "Yes, through Wisetack, including 0% APR for 24 months for qualified borrowers.",
  },
  {
    question: "Do you offer free estimates?",
    answer: "Yes. Call or request one online and we'll schedule a time to come look at your roof.",
  },
];
---

<InteriorLayout
  title="Roof Replacement | Triple R Roofing"
  description="Full tear-off and replacement roofing for Sacramento homes. Licensed, bonded, and insured, GAF Certified and CertainTeed SELECT ShingleMaster."
>
  <PageHero
    title="Roof Replacement"
    description="Full tear-off and replacement for roofs that are past the point of repair."
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: "Roof Replacement" },
    ]}
  />

  <section class="overview">
    <Container>
      <div class="overview__grid">
        <div class="overview__content" data-reveal>
          <p class="eyebrow">Roof Replacement</p>
          <h2 class="overview__headline">When repair isn&rsquo;t enough.</h2>
          <p class="overview__body">
            Most roofing problems start small: a leak, a few damaged shingles,
            storm wear on one slope. Those are usually a repair, not a full
            replacement, and we&rsquo;ll tell you that plainly if that&rsquo;s
            what your roof needs.
          </p>
          <p class="overview__body">
            A full replacement makes sense when the issue isn&rsquo;t isolated.
            That&rsquo;s when patching a section would just be delaying the
            same problem, and starting over from the deck up is the more
            honest fix.
          </p>
        </div>

        <div class="overview__media" data-reveal-media>
          <ResponsiveImage
            src={overviewImage}
            alt="A Triple R crew member installing shingles during a roof replacement in North Highlands, California."
            widths={[400, 600, 800, 1200]}
            sizes="(min-width: 900px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
      </div>
    </Container>
  </section>

  <ServiceIncludes
    eyebrow="What's included"
    headline="What goes into a roof replacement."
    items={INCLUDES}
  />

  <section class="deck-video">
    <Container>
      <div class="deck-video__intro" data-reveal>
        <p class="eyebrow">Deck Inspection &amp; Repair</p>
        <h2 class="deck-video__headline">What happens when we find dry rot.</h2>
        <p class="deck-video__body">
          Rogelio explains where dry rot commonly shows up and shows a
          real project where damaged wood had to be repaired before the
          new roofing materials went down.
        </p>
      </div>

      <div class="deck-video__frame" data-reveal-media>
        <PlayableVideo
          poster={DECK_VIDEO_POSTER}
          alt="Rogelio explains dry rot found and repaired on a real roof replacement job."
          aspectRatio="9 / 16"
          muxPlaybackId={DECK_VIDEO_MUX_ID}
        />
      </div>
    </Container>
  </section>

  <section class="replacement-spotlight">
    <Container>
      <div data-reveal>
        <p class="eyebrow replacement-spotlight__eyebrow">Recent work</p>
        <p class="replacement-spotlight__meta">Roof Replacement &middot; North Highlands, CA</p>
      </div>

      <div class="replacement-spotlight__frame" data-reveal-media>
        <PlayableVideo
          poster={NORTH_HIGHLANDS_POSTER}
          alt="Drone footage of a completed roof replacement in North Highlands, California."
          aspectRatio="16 / 9"
          muxPlaybackId={NORTH_HIGHLANDS_MUX_ID}
        />
      </div>

      <p class="replacement-spotlight__caption">
        A completed roof replacement in North Highlands, shown from the air.
      </p>
    </Container>
  </section>

  <CertificationsSection
    eyebrow="Materials & Certifications"
    headline="Backed by the brands behind the roof."
    intro="Triple R Roofing holds certifications from GAF, CertainTeed, Owens Corning, and ASC, and is accredited by the Better Business Bureau."
    credentials={CREDENTIALS}
  />

  <FinancingCallout />

  <FAQSection
    eyebrow="Common Questions"
    headline="Roof replacement, answered"
    groupName="faq-roof-replacement"
    items={FAQS}
  />

  <FinalCtaSection
    headline="Let's look at your roof."
    body="Free, no-obligation estimates for roof replacements throughout Sacramento."
  />
</InteriorLayout>

<style>
  .overview {
    padding-block: var(--space-9);
  }

  /* Stacked (text above photo) on mobile, text-left/photo-right at
     desktop - same split as Tile Roofing's own overview section, applied
     here now that a real North Highlands jobsite photo exists to fill it
     instead of the old placeholder PhotoBand. */
  .overview__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  .overview__content {
    max-width: 720px;
  }

  .overview__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .overview__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
  }

  /* 4:5, not the source photo's own portrait ratio (1126:2000) - a
     gentler crop that still reads as a deliberate frame instead of a
     narrow sliver, while keeping more of the worker and roof context
     than a square crop would. */
  .overview__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .overview__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .overview__grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-8);
    }

    .overview__content {
      max-width: none;
    }
  }

  /* This section's own bottom padding plus ServiceIncludes' top padding
     (96px + 96px) left an oversized gap now that the old placeholder
     PhotoBand (which used to sit between them and absorb some of that
     visually) is gone - same issue already fixed elsewhere on the site
     (Tile Roofing's overview->ServiceTriad gap, this page's own
     deck-video section below). Unlike ServiceTriad, ServiceIncludes has
     no desktop-side reduction of its own, so this pull-up applies at
     every width rather than resetting to 0 past a breakpoint. `:global`
     is needed since ServiceIncludes renders its own `.includes` element
     under its own component scope - safe to apply unscoped here since
     this page is the only caller of ServiceIncludes. */
  :global(.includes) {
    margin-top: -80px;
  }

  /* ---- Deck inspection & repair video - a contained (not full-bleed)
     9:16 frame, same established pattern and sizing as the Roof Repair
     and Roof Maintenance video sections, kept separate from the
     "Recent work" ServiceProjectSpotlight below it. ---- */
  .deck-video {
    padding-block: var(--space-9);
    /* Mobile-only: ServiceIncludes' own bottom padding plus this section's
       top padding (96px + 96px) left an oversized gap between the process
       steps and this section on narrow screens. Pulling the section up
       closes that gap without touching either section's own padding
       (reset back to 0 on desktop below, where the two paddings already
       read fine together). */
    margin-top: calc(-1 * var(--space-9));
    text-align: center;
  }

  .deck-video__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .deck-video__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .deck-video__body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }

  .deck-video__frame {
    margin-top: var(--space-8);
    width: 100%;
    max-width: 300px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .deck-video {
      padding-block: var(--space-8);
      margin-top: 0;
    }

    .deck-video__frame {
      max-width: clamp(380px, 30vw, 430px);
    }
  }

  /* ---- Recent work (video) - contained within the page's normal
     content width (matching the Projects page's featured-project
     treatment), not a full-bleed 100vw frame like ServiceProjectSpotlight.
     A full-bleed frame reads oddly for a paused, click-to-play video at
     that scale; a contained frame (like Projects already uses for this
     exact clip) suits it better. Kept as page-local markup so the shared
     ServiceProjectSpotlight component - still used by Gutters and Tile
     Roofing for real photos, where full-bleed doesn't have this problem -
     never has to know about video. ---- */
  .replacement-spotlight {
    padding-block: var(--space-9);
  }

  .replacement-spotlight__eyebrow {
    margin-bottom: var(--space-3);
  }

  .replacement-spotlight__meta {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .replacement-spotlight__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .replacement-spotlight__caption {
    max-width: 62ch;
    margin-top: var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .replacement-spotlight__frame {
      max-height: 75vh;
    }
  }
</style>
