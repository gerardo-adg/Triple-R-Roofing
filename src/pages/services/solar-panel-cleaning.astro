---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PageHero from "../../components/PageHero.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";

// Confirmed directly by the client: Triple R cleans solar panels, not
// limited to roofs or panels they previously worked on. Everything else
// about the service - cleaning method, water type, chemicals, hard-water
// spot removal, recommended frequency, any efficiency/production/
// lifespan benefit, and whether financing applies - is unconfirmed and
// deliberately absent from this page. No FAQ (the only safe answers -
// licensed/insured/BBB, free estimates - are already covered elsewhere
// and didn't justify a thin accordion just for consistency with other
// service pages), no Financing (no evidence it applies to a service
// this size), no Recent Work spotlight (the Before & After section
// below serves that role better for this service, same reasoning as
// Moss Removal). Before/after photos are real completed Triple R work
// per the client, but not yet delivered - placeholders only, no
// invented location, panel type, or scope.
---

<InteriorLayout
  title="Solar Panel Cleaning | Triple R Roofing"
  description="Solar panel cleaning for homes in Sacramento, CA."
>
  <PageHero
    title="Solar Panel Cleaning"
    description="Solar panel cleaning for homes in Sacramento."
    image="/media/placeholder-page-hero-solar.svg"
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/#services" },
      { label: "Solar Panel Cleaning" },
    ]}
  />

  <section class="overview">
    <Container>
      <div class="overview__content">
        <p class="eyebrow">Solar Panel Cleaning</p>
        <h2 class="overview__headline">Panels collect dust and debris like anything else outside.</h2>
        <p class="overview__body">
          Dust, pollen, and debris settle on solar panels over time, the same
          way they do on any exterior surface. If your panels need cleaning,
          we can take a look.
        </p>
      </div>
    </Container>
  </section>

  <section class="before-after">
    <Container>
      <p class="eyebrow">Before &amp; After</p>

      <div class="before-after__grid">
        <figure class="before-after__frame">
          <span class="before-after__label">Before</span>
          <img
            src="/media/placeholder-solar-before.svg"
            alt="Placeholder. A real before photo from a completed solar panel cleaning job will replace this image."
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="before-after__divider" aria-hidden="true"></div>

        <figure class="before-after__frame">
          <span class="before-after__label">After</span>
          <img
            src="/media/placeholder-solar-after.svg"
            alt="Placeholder. A real after photo from a completed solar panel cleaning job will replace this image."
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <p class="before-after__caption">
        Before-and-after photos from a completed job coming soon.
      </p>
    </Container>
  </section>

  <FinalCtaSection
    headline="Let's get your panels cleaned."
    body="Request a free estimate and we'll come take a look."
  />
</InteriorLayout>

<style>
  .overview {
    padding-block: var(--space-9);
  }

  .overview__content {
    max-width: 720px;
  }

  .overview__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .overview__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
  }

  /* ---- Before & After ---- */
  .before-after {
    padding-block: var(--space-9);
  }

  .before-after__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .before-after__frame {
    position: relative;
    margin: 0;
  }

  .before-after__frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .before-after__label {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: rgb(10 10 10 / 55%);
    padding: var(--space-1) var(--space-3);
  }

  .before-after__divider {
    display: none;
  }

  .before-after__caption {
    margin-top: var(--space-5);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 700px) {
    .before-after__grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }

    .before-after__divider {
      display: block;
      width: 1px;
      background: var(--color-border);
    }
  }
</style>
