---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PageHero from "../../components/PageHero.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import pageHeroImage from "../../assets/media/placeholder-page-hero-solar.svg";

// Confirmed directly by the client: Triple R cleans solar panels, not
// limited to roofs or panels they previously worked on. Everything else
// about the service - cleaning method, water type, chemicals, hard-water
// spot removal, recommended frequency, any efficiency/production/
// lifespan benefit, and whether financing applies - is unconfirmed and
// deliberately absent from this page. No FAQ (the only safe answers -
// licensed/insured/BBB, free estimates - are already covered elsewhere
// and didn't justify a thin accordion just for consistency with other
// service pages), no Financing (no evidence it applies to a service
// this size). The Before & After section this page used to reserve for
// real photos (never delivered) is replaced below by a real client-
// provided video of the crew cleaning panels - no invented location or
// scope, same restraint as the rest of this page.
const SOLAR_VIDEO_MUX_ID = "83p6u26MgEfTmz4Sp1n7j00acOhbRCLZUlvbnNILLGFY";
const SOLAR_VIDEO_POSTER = `https://image.mux.com/${SOLAR_VIDEO_MUX_ID}/thumbnail.jpg?time=2`;

// Second client-provided clip, same job - poster frame time (14s) is
// client-confirmed, unlike the first video's (still a placeholder
// guess pending confirmation).
const SOLAR_VIDEO_2_MUX_ID = "8aGNK013Aj22CndKpzRsh9niYT6wRoVM6JbNJT1x00008s";
const SOLAR_VIDEO_2_POSTER = `https://image.mux.com/${SOLAR_VIDEO_2_MUX_ID}/thumbnail.jpg?time=14`;
---

<InteriorLayout
  title="Solar Panel Cleaning | Triple R Roofing"
  description="Solar panel cleaning for homes in Sacramento, CA."
>
  <PageHero
    title="Solar Panel Cleaning"
    description="Solar panel cleaning for homes in Sacramento."
    image={pageHeroImage}
    breadcrumbs={[
      { label: "Home", href: "/" },
      { label: "Services", href: "/services" },
      { label: "Solar Panel Cleaning" },
    ]}
  />

  <section class="overview">
    <Container>
      <div class="overview__content" data-reveal>
        <p class="eyebrow">Solar Panel Cleaning</p>
        <h2 class="overview__headline">Panels collect dust and debris like anything else outside.</h2>
        <p class="overview__body">
          Dust, pollen, and debris settle on solar panels over time, the same
          way they do on any exterior surface. If your panels need cleaning,
          we can take a look.
        </p>
      </div>
    </Container>
  </section>

  <section class="solar-video">
    <Container>
      <div class="solar-video__intro" data-reveal>
        <p class="eyebrow">Recent work</p>
        <h2 class="solar-video__headline">See the crew cleaning panels.</h2>
      </div>

      <div class="solar-video__grid">
        <div class="solar-video__frame" data-reveal-media>
          <PlayableVideo
            poster={SOLAR_VIDEO_POSTER}
            alt="The Triple R crew cleaning solar panels."
            aspectRatio="9 / 16"
            muxPlaybackId={SOLAR_VIDEO_MUX_ID}
          />
        </div>

        <div class="solar-video__frame" data-reveal-media>
          <PlayableVideo
            poster={SOLAR_VIDEO_2_POSTER}
            alt="The Triple R crew cleaning solar panels."
            aspectRatio="9 / 16"
            muxPlaybackId={SOLAR_VIDEO_2_MUX_ID}
          />
        </div>
      </div>
    </Container>
  </section>

  <FinalCtaSection
    headline="Let's get your panels cleaned."
    body="Request a free estimate and we'll come take a look."
  />
</InteriorLayout>

<style>
  .overview {
    padding-block: var(--space-9);
  }

  .overview__content {
    max-width: 720px;
  }

  .overview__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .overview__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
  }

  /* ---- Recent work (two videos) - stacked single column on mobile,
     side by side at desktop (two 9:16 frames, not one), per the two
     separate client-provided clips from the same job. ---- */
  .solar-video {
    padding-block: var(--space-9);
    text-align: center;
    /* Mobile-only: this section's own top padding plus the overview
       section's bottom padding (96px + 96px) stacked into an oversized
       gap - same issue already fixed elsewhere (Tile Roofing's
       overview->ServiceTriad gap). Reset to 0 at 900px, where this
       section's own desktop padding reduction below already tightens it
       from the other side. */
    margin-top: -60px;
  }

  .solar-video__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .solar-video__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
  }

  .solar-video__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-8);
    max-width: 300px;
    margin-inline: auto;
  }

  .solar-video__frame {
    width: 100%;
  }

  @media (min-width: 700px) {
    .solar-video__grid {
      grid-template-columns: 1fr 1fr;
      max-width: 640px;
    }
  }

  @media (min-width: 900px) {
    .solar-video {
      padding-block: var(--space-8);
      margin-top: 0;
    }

    .solar-video__grid {
      max-width: clamp(560px, 46vw, 760px);
    }
  }
</style>
