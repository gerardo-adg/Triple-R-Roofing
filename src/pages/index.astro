---
// Phase 3: navigation + hero only. Sections below the hero are Phase 4.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout
  title="Triple R Roofing | Roofing, Roof Repair & Gutters in Sacramento, CA"
  description="Triple R Roofing provides roof replacement, roof repair, tile roofing, gutters, and related services in Sacramento, CA."
>
  <Header />
  <main id="main">
    <Hero
      lines={["Roofing.", "Roof Repair.", "Gutters."]}
      location="Sacramento, California"
      primaryCta={{ label: "Request a Free Estimate", href: "/contact" }}
      secondaryCta={{ label: "Call (916) 420-5635", href: "tel:+19164205635" }}
      poster="/media/placeholder-poster.svg"
      alt="Placeholder — cinematic drone or installation footage will replace this poster once final media is delivered"
    />
  </main>
</BaseLayout>
