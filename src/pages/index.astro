---
// Full homepage: Hero -> Trust -> Services -> Family -> Featured Work ->
// Process -> Financing -> Final CTA -> Footer. This completes the
// target section order for the homepage build.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustSection from "../components/TrustSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import FamilySection from "../components/FamilySection.astro";
import FeaturedWorkSection from "../components/FeaturedWorkSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import FinancingSection from "../components/FinancingSection.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";
import Footer from "../components/Footer.astro";

// Real client-provided hero footage: a vertically-shot phone clip for
// mobile, a separate horizontally-shot clip for desktop - a single crop
// rarely reads well at both aspect ratios, same reasoning as every other
// mobile/desktop media split on this site.
const HERO_MOBILE_MUX_ID = "WQbU1fu02qE5fijk1PwcG5blondCoPwk02018PeOmi6hII";
const HERO_MOBILE_POSTER = `https://image.mux.com/${HERO_MOBILE_MUX_ID}/thumbnail.jpg?time=7`;
const HERO_DESKTOP_MUX_ID = "SoUsS7cG7ImDlyflXc00Tezob9IRgm1m2bf801MJWAKaU";
// No poster time given for this clip - 1s is a placeholder; tell me the
// right timestamp and I'll swap it in.
const HERO_DESKTOP_POSTER = `https://image.mux.com/${HERO_DESKTOP_MUX_ID}/thumbnail.jpg?time=1`;
---

<BaseLayout
  title="Triple R Roofing | Roofing, Roof Repair & Gutters in Sacramento, CA"
  description="Triple R Roofing provides roof replacement, roof repair, tile roofing, gutters, and related services in Sacramento, CA."
>
  <Header />
  <main id="main">
    <Hero
      lines={["Premier Roofing", "in Sacramento."]}
      mobileLines={["Premier", "Roofing", "Services in", "Sacramento."]}
      subheadline="Roof replacements, repairs, and gutter services for homeowners throughout the Sacramento area."
      primaryCta={{ label: "Get a Free Estimate", href: "/contact" }}
      secondaryCta={{ label: "Call (916) 420-5635", href: "tel:+19164205635" }}
      poster={HERO_DESKTOP_POSTER}
      muxPlaybackId={HERO_DESKTOP_MUX_ID}
      mobilePoster={HERO_MOBILE_POSTER}
      mobileMuxPlaybackId={HERO_MOBILE_MUX_ID}
      alt="Cinematic footage of a Triple R Roofing roofing project in Sacramento, CA."
    />
    <TrustSection />
    <ServicesSection />
    <FamilySection />
    <FeaturedWorkSection />
    <ReviewsSection />
    <ProcessSection />
    <FinancingSection />
    <FinalCtaSection />
  </main>
  <Footer />
</BaseLayout>
