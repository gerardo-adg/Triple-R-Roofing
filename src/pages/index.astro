---
// Homepage sections built so far: Hero, Trust, Services, Family, Featured
// Work, Process, Financing. Target final order: Hero -> Trust -> Services
// -> Family -> Featured Work -> Process -> Financing -> Final CTA ->
// Footer. Final CTA and Footer still need to be built.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustSection from "../components/TrustSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import FamilySection from "../components/FamilySection.astro";
import FeaturedWorkSection from "../components/FeaturedWorkSection.astro";
import ProcessSection from "../components/ProcessSection.astro";
import FinancingSection from "../components/FinancingSection.astro";
---

<BaseLayout
  title="Triple R Roofing | Roofing, Roof Repair & Gutters in Sacramento, CA"
  description="Triple R Roofing provides roof replacement, roof repair, tile roofing, gutters, and related services in Sacramento, CA."
>
  <Header />
  <main id="main">
    <Hero
      lines={["Premier Roofing", "in Sacramento."]}
      subheadline="Sacramento's choice for quality roof replacements, fast leak repairs, and custom gutter installations. Licensed and insured."
      primaryCta={{ label: "Get a Free Estimate", href: "/contact" }}
      secondaryCta={{ label: "Call (916) 420-5635", href: "tel:+19164205635" }}
      poster="/media/placeholder-poster.svg"
      alt="Placeholder image. Cinematic drone or installation footage will replace this poster once final media is delivered."
    />
    <TrustSection />
    <ServicesSection />
    <FamilySection />
    <FeaturedWorkSection />
    <ProcessSection />
    <FinancingSection />
  </main>
</BaseLayout>
