---
// Phase 4A: hero + first 2 sections (trust, services). The rest of the
// homepage is later phases.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustSection from "../components/TrustSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
---

<BaseLayout
  title="Triple R Roofing | Roofing, Roof Repair & Gutters in Sacramento, CA"
  description="Triple R Roofing provides roof replacement, roof repair, tile roofing, gutters, and related services in Sacramento, CA."
>
  <Header />
  <main id="main">
    <Hero
      lines={["Premier Roofing", "in Sacramento."]}
      subheadline="Sacramento's choice for quality roof replacements, fast leak repairs, and custom gutter installations. Licensed and insured."
      primaryCta={{ label: "Get a Free Estimate", href: "/contact" }}
      secondaryCta={{ label: "Call (916) 420-5635", href: "tel:+19164205635" }}
      poster="/media/placeholder-poster.svg"
      alt="Placeholder — cinematic drone or installation footage will replace this poster once final media is delivered"
    />
    <TrustSection />
    <ServicesSection />
  </main>
</BaseLayout>
