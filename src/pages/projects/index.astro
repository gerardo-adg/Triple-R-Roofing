---
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import Container from "../../components/Container.astro";
import PlayableVideo from "../../components/PlayableVideo.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import ProjectMapSection from "../../components/ProjectMapSection.astro";
import FinalCtaSection from "../../components/FinalCtaSection.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import placeholderPoster from "../../assets/media/placeholder-project-featured.svg";
import sacramentoReplacementImage2 from "../../assets/media/photo-replacement-sacramento-completed-2.jpg";
import type { ImageMetadata } from "astro";

// No two real projects should ever imply one matters more than the
// other - every project renders at the same visual weight in one
// consistent grid (2 columns desktop, 1 mobile). `spanFull` is the only
// way a project can span both columns, and it's a deliberate,
// per-project content decision (an exceptionally strong project that
// earns a larger treatment) - never automatic, and not set here.
//
// Visible metadata is deliberately restrained to service type and
// location - description, materialType, and completedDate exist in the
// data shape for later, but are never rendered just because they're
// present.
interface ProjectMedia {
  type: "photo" | "video" | "before-after" | "gallery";
  image?: ImageMetadata;
  imageAlt?: string;
  poster?: ImageMetadata | string;
  videoAlt?: string;
  muxPlaybackId?: string;
  before?: { image: ImageMetadata; alt: string };
  after?: { image: ImageMetadata; alt: string };
  additionalCount?: number;
  /** Defaults to 16:9 (see .project-tile__media below) - set only when
   * a photo/video's actual composition would be aggressively cropped by
   * that default (e.g. a portrait or square shot). */
  aspectRatio?: string;
}

interface Project {
  serviceType: string;
  /** Left out of the data entirely (not invented) until confirmed for a
   * given project - the tag below just skips the second line then. */
  location?: string;
  description?: string;
  materialType?: string;
  completedDate?: string;
  spanFull?: boolean;
  media: ProjectMedia;
  href?: string;
}

// First real project: drone footage of a completed roof replacement in
// North Highlands, CA. Only confirmed facts are used - no material,
// scope, or completion date, since none of that has been provided. It
// is one completed job among others, not a "featured" one - no
// spanFull, no larger treatment, just the standard grid tile. New
// projects added here appear in the same grid automatically.
const NORTH_HIGHLANDS_MUX_ID = "8G23HDzQ7IbFqq01E9wl8c7lfS9B491xkVCJ00p4Q02sQM";
const NORTH_HIGHLANDS_POSTER = `https://image.mux.com/${NORTH_HIGHLANDS_MUX_ID}/thumbnail.jpg?time=10`;

// Second real project: the same client-provided solar panel cleaning
// clip used on the Solar Panel Cleaning service page (vertical, shot on
// an iPhone, not drone) - no location confirmed, so none is set here.
// aspectRatio is set explicitly since this tile's own source video is
// portrait, not the grid's 16:9 default.
const SOLAR_CLEANING_MUX_ID = "83p6u26MgEfTmz4Sp1n7j00acOhbRCLZUlvbnNILLGFY";
const SOLAR_CLEANING_POSTER = `https://image.mux.com/${SOLAR_CLEANING_MUX_ID}/thumbnail.jpg?time=2`;

// Third real project: drone video of the same Sacramento roof
// replacement the first still photo showed - replaces that photo
// entirely (not shown alongside it) so the same job isn't listed twice.
// Poster frame time (11s) is client-confirmed.
const SACRAMENTO_MUX_ID = "zS3heVPb02oLBsj9tflDaDjMrfCQjmFLncLL00F00bZ7yI";
const SACRAMENTO_POSTER = `https://image.mux.com/${SACRAMENTO_MUX_ID}/thumbnail.jpg?time=11`;

// Fourth real project: another drone video of a completed roof
// replacement, client-provided - no location confirmed, so none is set
// here. Poster frame time (3s) is client-confirmed.
const REPLACEMENT_2_MUX_ID = "D2CkNoPYp1cfHCpzS4100jnb2PJuGPegwRG6DMr6gM3o";
const REPLACEMENT_2_POSTER = `https://image.mux.com/${REPLACEMENT_2_MUX_ID}/thumbnail.jpg?time=3`;

// Sixth real project: the same real drone footage already used on the
// Tile Roofing service page (horizontal, 16:9 - no aspectRatio override
// needed). Location/poster time match that page exactly.
const TILE_MUX_ID = "KnMcBpUJ6oGWLYkFe01BIOSwHQstRnvJkK02lJLSqDAMs";
const TILE_POSTER = `https://image.mux.com/${TILE_MUX_ID}/thumbnail.jpg?time=15`;

const PROJECTS: Project[] = [
  {
    serviceType: "Roof Replacement",
    location: "North Highlands, CA",
    media: {
      type: "video",
      poster: NORTH_HIGHLANDS_POSTER,
      videoAlt: "Drone footage of a completed roof replacement in North Highlands, California.",
      muxPlaybackId: NORTH_HIGHLANDS_MUX_ID,
    },
  },
  {
    serviceType: "Solar Panel Cleaning",
    media: {
      type: "video",
      poster: SOLAR_CLEANING_POSTER,
      videoAlt: "The Triple R crew cleaning solar panels.",
      muxPlaybackId: SOLAR_CLEANING_MUX_ID,
      aspectRatio: "9 / 16",
    },
  },
  {
    serviceType: "Roof Replacement",
    location: "Sacramento, CA",
    media: {
      type: "video",
      poster: SACRAMENTO_POSTER,
      videoAlt: "Drone footage of a completed roof replacement in Sacramento, California.",
      muxPlaybackId: SACRAMENTO_MUX_ID,
      // Vertical footage - the grid's 16:9 default would crop most of
      // it away.
      aspectRatio: "9 / 16",
    },
  },
  {
    serviceType: "Roof Replacement",
    location: "Sacramento, CA",
    media: {
      type: "photo",
      image: sacramentoReplacementImage2,
      imageAlt: "Aerial view of a second completed roof replacement in Sacramento, California.",
      aspectRatio: "3 / 4",
    },
  },
  {
    serviceType: "Roof Replacement",
    media: {
      type: "video",
      poster: REPLACEMENT_2_POSTER,
      videoAlt: "Drone footage of a completed roof replacement.",
      muxPlaybackId: REPLACEMENT_2_MUX_ID,
      // Vertical footage - same reasoning as the Sacramento video above.
      aspectRatio: "9 / 16",
    },
  },
  {
    serviceType: "Tile Roofing",
    location: "Sacramento, CA",
    media: {
      type: "video",
      poster: TILE_POSTER,
      videoAlt: "Drone footage of a Triple R tile roofing project.",
      muxPlaybackId: TILE_MUX_ID,
    },
  },
];
---

<InteriorLayout
  title="Projects | Triple R Roofing"
  description="Recent roofing and gutter work from around the Sacramento area."
  headerAlwaysSolid
>
  <section class="projects-header">
    <Container>
      <nav class="projects-header__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Projects</span>
      </nav>
      <h1 class="projects-header__title">Projects</h1>
      <p class="projects-header__description">
        Recent roofing and gutter work from around the Sacramento area.
      </p>
    </Container>
  </section>

  {PROJECTS.length > 0 && (
  <section class="project-grid">
    <Container>
      <div class="project-grid__list">
        {PROJECTS.map((project) => {
          const Tag = project.href ? "a" : "div";
          const aspectRatio = project.media.aspectRatio ?? "16 / 9";
          return (
            <Tag
              class:list={["project-tile", { "project-tile--span-full": project.spanFull }]}
              {...(project.href ? { href: project.href } : {})}
            >
              <div class="project-tile__media" style={`aspect-ratio: ${aspectRatio};`} data-reveal-media>
                {project.media.type === "photo" && project.media.image && (
                  <ResponsiveImage
                    src={project.media.image}
                    alt={project.media.imageAlt ?? ""}
                    widths={[480, 640, 960, 1280]}
                    sizes="(min-width: 700px) 50vw, 100vw"
                    loading="lazy"
                  />
                )}
                {project.media.type === "video" && (
                  <PlayableVideo
                    poster={project.media.poster ?? placeholderPoster}
                    alt={project.media.videoAlt ?? ""}
                    aspectRatio={aspectRatio}
                    muxPlaybackId={project.media.muxPlaybackId}
                  />
                )}
                {project.media.type === "before-after" && project.media.before && project.media.after && (
                  <BeforeAfter
                    beforeImage={project.media.before.image}
                    beforeAlt={project.media.before.alt}
                    afterImage={project.media.after.image}
                    afterAlt={project.media.after.alt}
                  />
                )}
                {project.media.type === "gallery" && project.media.image && (
                  <>
                    <ResponsiveImage
                      src={project.media.image}
                      alt={project.media.imageAlt ?? ""}
                      widths={[480, 640, 960, 1280]}
                      sizes="(min-width: 700px) 50vw, 100vw"
                      loading="lazy"
                    />
                    {project.media.additionalCount && (
                      <span class="project-tile__more">
                        +{project.media.additionalCount} more photos
                      </span>
                    )}
                  </>
                )}
              </div>

              <div class="project-tile__info" data-reveal>
                <p class="project-tile__service">{project.serviceType}</p>
                {project.location && <p class="project-tile__location">{project.location}</p>}
              </div>
            </Tag>
          );
        })}
      </div>
    </Container>
  </section>
  )}

  <ProjectMapSection />

  <FinalCtaSection
    headline="Thinking about a project?"
    body="Request a free estimate and we'll come take a look."
  />
</InteriorLayout>

<style>
  /* ---- Header (no PageHero - a quiet, gallery-first opener) ---- */
  .projects-header {
    padding-top: calc(var(--nav-height) + var(--space-7));
    padding-bottom: var(--space-8);
  }

  .projects-header__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .projects-header__breadcrumb a {
    color: var(--color-text-muted);
  }

  .projects-header__breadcrumb a:hover {
    color: var(--color-accent-strong);
  }

  .projects-header__breadcrumb [aria-current] {
    color: var(--color-accent-strong);
  }

  .projects-header__title {
    font-size: var(--text-h2);
    margin-bottom: var(--space-4);
  }

  .projects-header__description {
    max-width: 52ch;
    font-size: var(--text-body-lg);
  }

  /* ---- Portfolio grid - every project at the same visual weight, 2
     columns desktop / 1 column mobile. No cards: no border, shadow,
     radius, or background box around a tile - the photo/video itself,
     plus two lines of minimal metadata below it, is the whole tile. */
  .project-grid {
    padding-bottom: var(--space-9);
  }

  .project-grid__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8) var(--space-7);
  }

  /* Plain block until a project gets a real detail page (see href in
     the data shape) - then it renders as this same tile, now a link. */
  .project-tile {
    display: block;
    color: inherit;
  }

  a.project-tile:hover .project-tile__service,
  a.project-tile:focus-visible .project-tile__service {
    color: var(--color-accent-strong);
  }

  a.project-tile:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    outline-offset: 4px;
  }

  .project-tile__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .project-tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-tile__more {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: rgb(10 10 10 / 55%);
    padding: var(--space-1) var(--space-3);
  }

  .project-tile__info {
    margin-top: var(--space-3);
  }

  .project-tile__service {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
  }

  .project-tile__location {
    margin-top: var(--space-1);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 700px) {
    .project-grid__list {
      grid-template-columns: 1fr 1fr;
      /* Grid's default align-items:stretch was stretching each
         .project-tile to match its row's tallest sibling - invisible
         for same-aspect-ratio tiles, but a portrait (9:16) tile next to
         a landscape (16:9) one left a large dead gap below the shorter
         tile's caption. Aligning to each tile's own natural height
         instead lets differing aspect ratios sit at their real height
         with no forced blank space, while keeping every tile the same
         grid-column width (no card reads as more "important"). */
      align-items: start;
    }

    /* The only way a project spans both columns - an explicit,
       per-project opt-in (see `spanFull` in the data shape above), never
       automatic. Capped height so it stays a strong moment without
       reading as a second full-screen hero. */
    .project-tile--span-full {
      grid-column: 1 / -1;
    }

    .project-tile--span-full .project-tile__media {
      max-height: 70vh;
    }
  }
</style>
