---
import InteriorLayout from "../layouts/InteriorLayout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import PlayableVideo from "../components/PlayableVideo.astro";
import FinalCtaSection from "../components/FinalCtaSection.astro";

// Confirmed facts only. Family is introduced collectively (not individual
// bios) - we have full names for Rogelio, his father, and two brothers,
// but no individual roles/anecdotes to justify separate profiles, and no
// fake team cards. Uncles stay unnamed per the client. No founding year,
// years-in-business, project counts, employee count, generations claim,
// awards, or origin-story/values language - none of that has been
// confirmed. The video referenced below is the single confirmed ~34s
// family/Triple-R clip, delivered via Mux, already used (in compact
// form) on the homepage FamilySection - no other family videos are
// assumed here.
const FAMILY_VIDEO_MUX_ID = "SD1osly2CMfZzT9PsdLPNsg57WzoMrDYstt9STKl02Fk";
// Same client-confirmed frame choice as FamilySection.astro - see the
// comment there.
const FAMILY_VIDEO_POSTER = `https://image.mux.com/${FAMILY_VIDEO_MUX_ID}/thumbnail.jpg?time=1`;

// A second, separate Mux video: ~1:55, vertical, Rogelio on an active
// Triple R job site introducing the crew - a company/team trust-building
// piece, deliberately distinct in content from the name-origin clip
// above (not a duplicate message). Same burned-in-captions caveat as
// the family video.
const TEAM_VIDEO_MUX_ID = "H7UV01an86XuL28BGZeLY7X0101WzhdWbX5YyetOcItpdc";
const TEAM_VIDEO_POSTER = `https://image.mux.com/${TEAM_VIDEO_MUX_ID}/thumbnail.jpg?time=2`;
---

<InteriorLayout
  title="About | Triple R Roofing"
  description="Triple R Roofing is a family-owned roofing and gutter company in Sacramento, CA, run by Rogelio Ramirez and his family."
>
  <section class="name-reveal section--inverse">
    <Container>
      <nav class="name-reveal__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">About</span>
      </nav>

      <p class="eyebrow">About Triple R</p>

      <div class="name-reveal__lines">
        <p class="name-reveal__line">Rogelio.</p>
        <p class="name-reveal__line name-reveal__line--accent">Ramirez.</p>
        <p class="name-reveal__line">Roofing.</p>
      </div>

      <p class="name-reveal__copy">
        Triple R Roofing is a family-owned company named for its owner,
        Rogelio Ramirez. Three words. Three R's.
      </p>
    </Container>
  </section>

  <section class="family-story">
    <Container>
      <div class="family-story__intro" data-reveal>
        <p class="eyebrow">The family behind Triple R</p>
        <h2 class="family-story__headline">The family</h2>
        <p class="family-story__body">
          Rogelio Ramirez runs Triple R Roofing alongside his family. His
          father, also named Rogelio Ramirez, works with him, along with his
          brothers David Rogelio Ramirez and Abraham Rogelio Ramirez and
          their uncles.
        </p>
      </div>

      <div class="family-story__video" data-reveal-media>
        <PlayableVideo
          poster={FAMILY_VIDEO_POSTER}
          alt="Rogelio Ramirez explains what Triple R Roofing stands for."
          aspectRatio="9 / 16"
          muxPlaybackId={FAMILY_VIDEO_MUX_ID}
        />
        <p class="family-story__caption">Rogelio Ramirez explains Triple R.</p>
      </div>
    </Container>
  </section>

  <section class="meet-team section--inverse">
    <Container>
      <div class="meet-team__grid">
        <div class="meet-team__content" data-reveal>
          <p class="eyebrow">Meet the Team</p>
          <h2 class="meet-team__headline">On the job.</h2>
          <p class="meet-team__body">
            Rogelio introduces the crew behind Triple R on an active job
            site. These are the people who actually show up to do the
            work.
          </p>
        </div>

        <div class="meet-team__video" data-reveal-media>
          <PlayableVideo
            poster={TEAM_VIDEO_POSTER}
            alt="Rogelio introduces the Triple R team on a job site."
            aspectRatio="9 / 16"
            muxPlaybackId={TEAM_VIDEO_MUX_ID}
          />
        </div>
      </div>
    </Container>
  </section>

  <section class="what-we-do">
    <Container>
      <div class="what-we-do__content" data-reveal>
        <p class="eyebrow">What We Do</p>
        <h2 class="what-we-do__headline">Roofing services in Sacramento.</h2>
        <p class="what-we-do__body">
          Triple R Roofing helps homeowners throughout the Sacramento area
          with roof replacements, roof repairs, and gutter services. We also
          handle roof maintenance, tile and flat roofing, roof
          certifications, moss removal, roof rejuvenation, and roofing +
          solar projects.
        </p>
        <div class="what-we-do__links">
          <Button variant="text" href="/services/roof-replacement">Roof Replacement</Button>
          <Button variant="text" href="/services/roof-repair">Roof Repair</Button>
          <Button variant="text" href="/services/gutters">Gutters</Button>
        </div>
      </div>
    </Container>
  </section>

  <FinalCtaSection
    headline="Ready to work with Triple R?"
    body="Reach out and we'll come take a look."
  />
</InteriorLayout>

<style>
  /* ---- The Name ---- */
  .name-reveal {
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-10);
  }

  .name-reveal__breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted-inverse);
    margin-bottom: var(--space-6);
  }

  .name-reveal__breadcrumb a {
    color: var(--color-text-muted-inverse);
  }

  .name-reveal__breadcrumb a:hover {
    color: var(--color-gold);
  }

  .name-reveal__breadcrumb [aria-current] {
    color: var(--color-gold);
  }

  .name-reveal__lines {
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .name-reveal__line {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-expanded);
    font-size: clamp(2.25rem, 0.75rem + 6.7vw, 6.5rem);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text-inverse);
  }

  .name-reveal__line--accent {
    color: var(--color-gold);
  }

  .name-reveal__copy {
    max-width: 50ch;
    font-size: var(--text-body-lg);
    color: var(--color-text-muted-inverse);
  }

  @media (max-width: 899px) {
    .name-reveal {
      padding-top: calc(var(--nav-height) + var(--space-6));
      padding-bottom: var(--space-8);
    }
  }

  /* ---- The Family ---- */
  .family-story {
    padding-top: var(--space-9);
    padding-bottom: var(--space-9);
    text-align: center;
  }

  /* Bottom padding only, desktop only - the combined gap before What We
     Do's own top padding read as more generous than intended once the
     video's own height was already providing plenty of visual weight and
     closure. Top padding (the gap under the intro paragraph) and mobile
     spacing are untouched. */
  @media (min-width: 900px) {
    .family-story {
      padding-bottom: var(--space-6);
    }
  }

  .family-story__intro {
    max-width: 640px;
    margin-inline: auto;
  }

  .family-story__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .family-story__body {
    font-size: var(--text-body-lg);
    color: var(--color-text-muted);
  }

  .family-story__video {
    margin-top: var(--space-8);
    /* Shared by the video frame and its caption below, so the caption is
       bound to the exact same width/center axis as the frame rather than
       just inheriting text-align: center across the much wider section -
       that's what keeps it reading as directly attached to the video
       instead of merely centered somewhere near it. */
    --family-video-width: clamp(300px, 42vw, 480px);
  }

  .family-story__video :global(.playable-video) {
    width: var(--family-video-width);
    margin-inline: auto;
  }

  .family-story__caption {
    width: var(--family-video-width);
    margin-inline: auto;
    margin-top: var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* ---- Meet the Team ----
     Deliberately distinct from "The family" above it: dark
     (section--inverse) instead of light, a side-by-side grid instead of
     centered/stacked, and text leading instead of the video leading -
     three differences at once so two 9:16 videos on the same page don't
     read as a repeated pattern. */
  .meet-team {
    padding-block: var(--space-9);
  }

  .meet-team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  .meet-team__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .meet-team__body {
    font-size: var(--text-body-lg);
    max-width: 46ch;
  }

  .meet-team__video {
    /* Explicit width, not just max-width: PlayableVideo's own contents
       are all absolutely positioned, so it has no in-flow content to
       give this grid item an intrinsic size - without a definite width
       here, `margin-inline: auto` (a grid item alignment instruction,
       not classic block auto-margin centering) has nothing to center
       and collapses the box to 0. */
    width: 100%;
    /* ~87% of the frame's earlier 320px width - narrower on purpose,
       since "The family" video above already fills the same width the
       page up above; giving this one a bit more surrounding breathing
       room keeps the two from feeling like the same frame repeated. */
    max-width: 280px;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    /* Text leads, video trails - the reverse of the homepage FamilySection's
       video-first order, and no `order` override here (DOM order stays
       visual order), since this isn't the page's first human moment the
       way that section is.

       The text column is a bounded track (not `1fr`) so it only takes
       the width the copy actually needs, rather than stretching the
       whole way to the video and leaving a dead gap between them; any
       leftover row width lands outside the two-column block instead,
       which `justify-content: center` then balances within the section. */
    .meet-team__grid {
      grid-template-columns: minmax(0, 480px) clamp(320px, 34vw, 420px);
      justify-content: center;
      align-items: center;
      gap: var(--space-7);
    }

    .meet-team__video {
      max-width: none;
      margin-inline: 0;
    }
  }

  /* ---- What We Do ---- */
  .what-we-do {
    padding-block: var(--space-9);
  }

  .what-we-do__content {
    max-width: 720px;
  }

  .what-we-do__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .what-we-do__body {
    font-size: var(--text-body-lg);
    max-width: 62ch;
    margin-bottom: var(--space-6);
  }

  .what-we-do__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
</style>
