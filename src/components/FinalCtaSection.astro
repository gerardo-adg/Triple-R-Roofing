---
import Container from "./Container.astro";
import Button from "./Button.astro";

interface CTA {
  label: string;
  href: string;
}

interface Props {
  headline?: string;
  body?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
}

// Defaults match the original homepage copy, so <FinalCtaSection /> with
// no props keeps working exactly as before - interior pages override
// with page-specific copy instead of duplicating this component.
const {
  headline = "Let’s talk about your roof.",
  body = "Whether you need a repair, a replacement, or just want to know what condition your roof is in, we’ll come take a look.",
  primaryCta = { label: "Get a Free Estimate", href: "/contact" },
  secondaryCta = { label: "Call (916) 420-5635", href: "tel:+19164205635" },
} = Astro.props;
---

<section class="final-cta">
  <Container width="narrow">
    <div class="final-cta__content">
      <h2 class="final-cta__headline">{headline}</h2>
      <p class="final-cta__body">{body}</p>
      <div class="final-cta__actions">
        <Button variant="primary" href={primaryCta.href}>{primaryCta.label}</Button>
        <Button variant="secondary" href={secondaryCta.href}>{secondaryCta.label}</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Light/cream on purpose - Financing right before this is dark, and the
     Footer right after is dark too. Keeping this section on the default
     paper background is what keeps the page from reading as one large
     dark block at the very end. */
  .final-cta {
    padding-block: var(--space-9);
  }

  .final-cta__content {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .final-cta__headline {
    /* Slightly larger than --text-h2 rather than the token itself - at
       exactly --text-h2, this collided pixel-for-pixel with Family's
       headline (also --text-h2, but bold/normal-width rather than this
       section's black/expanded default), which read as an accidental
       inconsistency rather than intentional variation once the full
       page was reviewed together. */
    font-size: calc(var(--text-h2) * 1.08);
  }

  .final-cta__body {
    max-width: 46ch;
    margin-inline: auto;
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
</style>
