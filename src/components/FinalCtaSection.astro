---
import Container from "./Container.astro";
import Button from "./Button.astro";

interface CTA {
  label: string;
  href: string;
}

interface Props {
  headline?: string;
  body?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
}

// Defaults match the original homepage copy, so <FinalCtaSection /> with
// no props keeps working exactly as before - interior pages override
// with page-specific copy instead of duplicating this component.
const {
  headline = "Let’s talk about your roof.",
  body = "Whether you need a repair, a replacement, or just want to know what condition your roof is in, we’ll come take a look.",
  primaryCta = { label: "Get a Free Estimate", href: "/contact" },
  secondaryCta = { label: "Call (916) 420-5635", href: "tel:+19164205635" },
} = Astro.props;
---

<section class="final-cta section--inverse">
  <Container>
    <div class="final-cta__inner" data-reveal>
      <div class="final-cta__content">
        <h2 class="final-cta__headline">{headline}</h2>
        <p class="final-cta__body">{body}</p>
      </div>
      <div class="final-cta__actions">
        <Button variant="primary" inverse href={primaryCta.href}>{primaryCta.label}</Button>
        <Button variant="secondary" inverse href={secondaryCta.href}>{secondaryCta.label}</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Dark, but a shade lighter than the true-black Footer/Financing
     sections (--color-charcoal-raised vs --color-charcoal) - reads as
     the site's third and final dark band, not a merge with whatever
     dark section preceded it or the Footer right after. The gold top
     rule marks where the final conversion moment begins. */
  .final-cta {
    padding-block: var(--space-9);
    background: var(--color-charcoal-raised);
    border-top: 1px solid var(--color-border-gold);
  }

  .final-cta__inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .final-cta__headline {
    /* Slightly larger than --text-h2 rather than the token itself - at
       exactly --text-h2, this collided pixel-for-pixel with Family's
       headline (also --text-h2, but bold/normal-width rather than this
       section's black/expanded default), which read as an accidental
       inconsistency rather than intentional variation once the full
       page was reviewed together. */
    font-size: calc(var(--text-h2) * 1.08);
  }

  .final-cta__body {
    max-width: 46ch;
    margin-inline: auto;
    margin-top: var(--space-4);
    color: var(--color-text-muted-inverse);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  /* Desktop: horizontal, not centered - copy left, actions right,
     within a working measure narrower than the full container so the
     row doesn't stretch edge-to-edge on wide viewports. Mobile keeps
     the centered/stacked composition above untouched. flex-wrap is a
     safety net, not the primary layout: content's max-width (560px)
     plus actions normally leaves room in this row at typical desktop
     widths, but a long enough headline/body combination in the ~900-
     1024px band can exceed the available width - wrapping the actions
     to their own row there beats a horizontal scrollbar. Doesn't change
     anything at widths where the row already fits (verified against
     every page currently using this component). */
  @media (min-width: 900px) {
    .final-cta__inner {
      max-width: 1160px;
      text-align: left;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
    }

    .final-cta__content {
      max-width: 560px;
    }

    .final-cta__body {
      margin-inline: 0;
    }

    .final-cta__actions {
      flex-shrink: 0;
      flex-wrap: nowrap;
      justify-content: flex-start;
      margin-top: 0;
    }
  }
</style>
