---
import Container from "./Container.astro";
import Button from "./Button.astro";
import LazyVideo from "./LazyVideo.astro";
import { Image } from "astro:assets";
import logoMark from "../assets/media/logo-triple-r-roofing.webp";
import type { ImageMetadata } from "astro";

interface CTA {
  label: string;
  href: string;
}

interface Props {
  /** Headline authored as short, stacked lines — brand/message first, per the required hierarchy (media -> message -> location -> action). */
  lines: string[];
  /** Optional mobile-only override, for when the mobile headline needs
   * different wording/line breaks than desktop (not just a reflow of the
   * same text) - falls back to `lines` when not provided. */
  mobileLines?: string[];
  /** Secondary, smaller — should never compete with the headline. */
  subheadline: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  /** Used at >=900px, and at every width when no mobile* prop is given. */
  poster: ImageMetadata | string;
  alt: string;
  muxPlaybackId?: string;
  videoSrc?: string;
  /** Optional <900px overrides - a vertically-shot phone clip rarely
   * crops well into the same frame as a horizontal desktop one, same
   * reasoning as the headline's own mobileLines split above. Omit to use
   * the desktop media at every width. */
  mobilePoster?: ImageMetadata | string;
  mobileMuxPlaybackId?: string;
  mobileVideoSrc?: string;
  /** Test layout: swaps the headline/subheadline for the brand mark,
   * centered, with a single CTA beneath - everything else about the hero
   * (video, scroll effect, scrim) is unchanged. The headline/subheadline
   * copy is still required and still rendered, just visually hidden, so
   * the page keeps a real <h1> and doesn't lose any SEO text. */
  centeredLogo?: boolean;
  /** Test layout: keeps the real headline/subheadline text (not the logo),
   * just centered and smaller - independent of centeredLogo above. */
  centerHeadline?: boolean;
}

const {
  lines,
  mobileLines = lines,
  subheadline,
  primaryCta,
  secondaryCta,
  poster,
  alt,
  muxPlaybackId,
  videoSrc,
  mobilePoster,
  mobileMuxPlaybackId,
  mobileVideoSrc,
  centeredLogo = false,
  centerHeadline = false,
} = Astro.props;

const hasMobileVariant = Boolean(mobilePoster || mobileMuxPlaybackId || mobileVideoSrc);
---

<section class:list={["hero", centeredLogo && "hero--centered", centerHeadline && "hero--text-centered"]} data-hero>
  <div class="hero__media" data-hero-media aria-hidden="true">
    <div class="hero__media-inner">
      {hasMobileVariant && (
        <LazyVideo
          poster={mobilePoster ?? poster}
          alt={alt}
          hero
          muxPlaybackId={mobileMuxPlaybackId}
          src={mobileVideoSrc}
          aspectRatio="auto"
          class="hero__video hero__video--mobile"
        />
      )}
      <LazyVideo
        poster={poster}
        alt={alt}
        hero
        muxPlaybackId={muxPlaybackId}
        src={videoSrc}
        aspectRatio="auto"
        class:list={["hero__video", hasMobileVariant && "hero__video--desktop"]}
      />
    </div>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>

  <Container>
  <div class="hero__content">
    {centeredLogo ? (
      <>
        <h1 class="visually-hidden">{lines.join(" ")}</h1>
        <div class="hero__brand">
          <Image class="hero__brand-mark" src={logoMark} alt="" width={160} height={138} densities={[2, 3]} />
        </div>
      </>
    ) : (
      <>
        {centerHeadline && (
          <Image class="hero__brand-mark hero__brand-mark--above" src={logoMark} alt="" width={150} height={130} densities={[2, 3]} />
        )}
        <h1 class:list={["hero__headline", centerHeadline && "hero__headline--small"]}>
        <div class="hero__headline-set hero__headline-set--mobile">
          {mobileLines.map((line, i) => (
            <span class="hero__line-mask">
              <span class="hero__line" style={`animation-delay: ${140 + i * 110}ms`}>
                {line}
              </span>
            </span>
          ))}
        </div>
        <div class="hero__headline-set hero__headline-set--desktop">
          {lines.map((line, i) => (
            <span class="hero__line-mask">
              <span class="hero__line" style={`animation-delay: ${140 + i * 110}ms`}>
                {line}
              </span>
            </span>
          ))}
        </div>
      </h1>
      </>
    )}

    {!centeredLogo && (
      <p class:list={["hero__subheadline", centerHeadline && "hero__subheadline--small"]}>
        {subheadline}
      </p>
    )}

    <div class="hero__actions">
      <Button variant="primary" inverse href={primaryCta.href}>
        {primaryCta.label}
      </Button>
      {!centeredLogo && secondaryCta && (
        <Button variant="text" inverse href={secondaryCta.href}>
          {secondaryCta.label}
        </Button>
      )}
    </div>
  </div>
  </Container>

  <div class="hero__seam" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-charcoal);
    color: var(--color-text-inverse);
  }

  .hero--centered {
    align-items: center;
  }

  /*
    Media lives in its own isolated layer, separate from the entrance
    animation (.hero__media-inner) and from the scrim/content. This is the
    layer the scroll-driven transition (below) transforms directly — the
    signature interaction for this phase: as the hero scrolls past, the
    media eases inward and gains a soft frame rather than just sliding
    off-screen as a flat rectangle.
  */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    transform: scale(calc(1 - var(--hero-scroll, 0) * 0.06));
    border-radius: calc(var(--hero-scroll, 0) * 28px);
  }

  .hero__media-inner {
    position: absolute;
    inset: 0;
    transform: scale(1.045);
    opacity: 0.92;
    animation: hero-media-in var(--duration-slow) var(--ease-out) forwards;
  }

  .hero__media-inner :global(.lazy-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  /* Only present at all when a mobile-specific video was passed in (see
     hasMobileVariant above) - same breakpoint and "separate DOM, not
     reflowed" approach as the headline split below. display:none here is
     load-bearing, not just visual: LazyVideo's own script checks computed
     display before ever assigning a source, so the hidden one's video is
     never fetched.
     :global() is required here, not optional: these classes land on
     LazyVideo's own root element (a different component/scope), the same
     reason .hero__media-inner's own rule above needs it - without it,
     Astro scopes the selector to an attribute that element never carries,
     so the rule silently never matches. Previously unscoped, so both
     videos stayed display:block at every width and the later one in DOM
     order (desktop) visually covered the other up on every viewport. */
  :global(.hero__video--desktop) {
    display: none;
  }

  @media (min-width: 900px) {
    :global(.hero__video--mobile) {
      display: none;
    }

    :global(.hero__video--desktop) {
      display: block;
    }
  }

  /* Neutral near-black scrim — no warm tint. A tinted overlay here was the
     biggest single reason the previous version read brown/espresso instead
     of true black. The two gradients alone faded to fully transparent
     across the middle of the frame (24%-34% from the top), which was fine
     over the old static placeholder but let a bright/busy stretch of real
     video show through right where the headline sits. The flat wash
     underneath keeps a baseline darkness everywhere, with the gradients
     layered on top of it for the stronger cinematic falloff at the edges. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(10 10 10 / 65%) 0%, rgb(10 10 10 / 0%) 24%),
      linear-gradient(to top, rgb(10 10 10 / 78%) 0%, rgb(10 10 10 / 30%) 34%, rgb(10 10 10 / 0%) 58%),
      rgb(10 10 10 / 42%);
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--nav-height) + var(--space-6));
    padding-bottom: calc(clamp(140px, 20vh, 220px) + env(safe-area-inset-bottom));
  }

  .hero--centered .hero__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-7);
  }

  .hero__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    opacity: 0;
    animation: hero-fade-in var(--duration-slow) var(--ease-out) forwards;
    animation-delay: 140ms;
  }

  .hero__brand-mark {
    width: clamp(110px, 14vw, 160px);
    height: auto;
    filter: drop-shadow(0 2px 20px rgb(10 10 10 / 50%));
  }

  .hero--centered .hero__actions {
    justify-content: center;
    margin-top: var(--space-3);
  }

  /* Test layout (centerHeadline): desktop only - mobile keeps the
     original left-aligned, no-logo hero exactly as it was before this
     was ever added. A separate class from .hero--centered above (which
     still serves centeredLogo, unaffected, at every width) so this
     toggle can't accidentally change that other layout's behavior. */
  .hero__brand-mark--above {
    display: none;
  }

  @media (min-width: 900px) {
    .hero--text-centered {
      align-items: center;
    }

    .hero--text-centered .hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-block: var(--space-7);
    }

    .hero--text-centered .hero__actions {
      justify-content: center;
      margin-top: var(--space-3);
    }

    .hero__brand-mark--above {
      display: block;
      width: clamp(100px, 11vw, 150px);
      margin-bottom: var(--space-4);
      opacity: 0;
      animation: hero-fade-in var(--duration-base) var(--ease-out) forwards;
    }
  }

  /* Brand/message — the strongest element on the page. Two layers: a
     tight, strong contact shadow right at the letterforms for crisp edge
     definition, plus a larger soft one for separation from the footage
     behind it - stronger than a single soft glow alone without reading as
     a hard cartoon outline. */
  .hero__headline {
    color: var(--color-text-inverse);
    text-shadow:
      0 1px 3px rgb(10 10 10 / 85%),
      0 4px 28px rgb(10 10 10 / 65%);
    /* Max stop tuned to match where Container's own max-width (1320px)
       plateaus (~1320px viewport). Past that point the available line
       width stops growing, so letting the font size keep growing toward
       7rem caused an extra, unwanted wrap right around common desktop
       widths (confirmed: 2 lines from 1180-1400px, 3 lines from 1440px
       up under the old 7rem cap). Capping at 6rem keeps font growth and
       line-width growth in sync indefinitely. */
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }

  /* Two headline variants (mobile can carry different wording/line
     breaks than desktop, not just a reflow of the same text) - only one
     is ever visible at a time, toggled by breakpoint, same "separate
     DOM, not reflowed" approach the header already uses for its
     mobile/desktop nav. */
  .hero__headline-set--desktop {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__headline-set--mobile {
      display: none;
    }

    .hero__headline-set--desktop {
      display: block;
    }

    /* Smaller on desktop specifically so the headline/subheadline take up
       less of the frame and the video reads as the main event - mobile
       sizing above is untouched. */
    .hero__headline {
      font-size: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    }

    .hero__subheadline {
      font-size: var(--text-body-sm);
    }
  }

  /* Test layout (centerHeadline): desktop only, same as the centering
     rules above - mobile keeps the original full-size headline/
     subheadline. Compound selector (both classes on one rule, not two
     chained single-class rules) is load-bearing: the base .hero__headline/
     .hero__subheadline rules share the exact same specificity, and the
     base .hero__subheadline rule in particular comes AFTER this block in
     the file - with single-class selectors that source order would let it
     silently win the tie and cancel this override out entirely. */
  @media (min-width: 900px) {
    .hero__headline.hero__headline--small {
      font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    }

    .hero__subheadline.hero__subheadline--small {
      font-size: var(--text-body-sm);
      max-width: 36ch;
      margin-bottom: var(--space-4);
    }
  }

  .hero__line-mask {
    display: block;
    overflow: hidden;
    /* Safety net: if a future copy change introduces a word too long for
       its line, it breaks rather than silently overflowing off-screen. */
    overflow-wrap: break-word;
  }

  .hero__line {
    display: block;
    transform: translateY(110%);
    animation: hero-line-in var(--duration-slow) var(--ease-out) forwards;
  }

  /* Secondary by design — smaller, muted, constrained width so it never
     competes with the headline above it. */
  .hero__subheadline {
    max-width: 46ch;
    font-size: var(--text-body);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted-inverse);
    text-shadow:
      0 1px 2px rgb(10 10 10 / 80%),
      0 2px 16px rgb(10 10 10 / 55%);
    opacity: 0;
    animation: hero-fade-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: 460ms;
    margin-bottom: var(--space-7);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    opacity: 0;
    transform: translateY(8px);
    animation: hero-fade-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: 580ms;
  }

  .hero__seam {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    height: clamp(56px, 8vh, 110px);
    pointer-events: none;
    background: linear-gradient(to bottom, transparent 0%, transparent 40%, var(--color-bg) 100%);
  }

  @keyframes hero-media-in {
    from {
      transform: scale(1.045);
      opacity: 0.92;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes hero-line-in {
    from {
      transform: translateY(110%);
    }
    to {
      transform: translateY(0);
    }
  }

  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      /* "Sacramento." is the longest single word in the headline and
         can't break mid-word — measured against the actual rendered
         glyph widths at the narrowest supported viewport (375px), not
         estimated, with a margin of safety. */
      font-size: 2.1rem;
    }

    .hero__subheadline {
      margin-bottom: var(--space-6);
    }
  }
</style>

<script>
  // Signature interaction: as the hero scrolls past, its media layer eases
  // inward and softens into a frame instead of just sliding away as a flat
  // rectangle — using the isolated .hero__media layer built for exactly
  // this. One CSS custom property, set from scroll position; the actual
  // scale/radius easing lives in CSS above.
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const media = document.querySelector<HTMLElement>("[data-hero-media]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (hero && media && !reducedMotion) {
    let ticking = false;

    const update = () => {
      const rect = hero.getBoundingClientRect();
      const progress = Math.min(Math.max(-rect.top / rect.height, 0), 1);
      media.style.setProperty("--hero-scroll", progress.toFixed(3));
      ticking = false;
    };

    update();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>
