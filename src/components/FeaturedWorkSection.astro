---
import Container from "./Container.astro";
import ResponsiveImage from "./ResponsiveImage.astro";
import PlayableVideo from "./PlayableVideo.astro";
import projectImage3 from "../assets/media/placeholder-project-3.svg";
import projectImage4 from "../assets/media/placeholder-project-4.svg";

// Real drone footage of a completed roof replacement in North
// Highlands, CA - the same horizontal (16:9) clip used on the Projects
// page and the Roof Replacement service page. The only confirmed-
// horizontal video so far (others sent so far were vertical footage
// mistakenly assumed 16:9 - see Projects page history) - more will
// slot in here as real horizontal project videos arrive.
const NORTH_HIGHLANDS_MUX_ID = "8G23HDzQ7IbFqq01E9wl8c7lfS9B491xkVCJ00p4Q02sQM";
const NORTH_HIGHLANDS_POSTER = `https://image.mux.com/${NORTH_HIGHLANDS_MUX_ID}/thumbnail.jpg?time=10`;

// Second real video: the same horizontal (16:9) tile-roofing drone clip
// used on the Tile Roofing service page and the Projects page.
const TILE_MUX_ID = "KnMcBpUJ6oGWLYkFe01BIOSwHQstRnvJkK02lJLSqDAMs";
const TILE_POSTER = `https://image.mux.com/${TILE_MUX_ID}/thumbnail.jpg?time=15`;

// Real project photography and captions (type, location) will replace
// the remaining placeholders once the client provides them. Placeholder
// count (4) and images are provisional - not meant to imply how many
// projects will ship.
const PROJECTS = [
  {
    index: "01",
    type: "video" as const,
    muxPlaybackId: NORTH_HIGHLANDS_MUX_ID,
    poster: NORTH_HIGHLANDS_POSTER,
    alt: "Drone footage of a completed roof replacement in North Highlands, California.",
    label: "Roof Replacement",
    location: "North Highlands, CA",
  },
  {
    index: "02",
    type: "video" as const,
    muxPlaybackId: TILE_MUX_ID,
    poster: TILE_POSTER,
    alt: "Drone footage of a Triple R tile roofing project.",
    label: "Tile Roofing",
    location: "Sacramento, CA",
  },
  { index: "03", type: "photo" as const, image: projectImage3 },
  { index: "04", type: "photo" as const, image: projectImage4 },
];
const total = String(PROJECTS.length).padStart(2, "0");
---

<section id="featured-work" class="featured-work section--inverse">
  <Container>
    <div class="featured-work__intro" data-reveal>
      <div>
        <p class="eyebrow">Featured work</p>
        <h2 class="featured-work__headline">Recent projects.</h2>
        <a href="/projects" class="featured-work__more">View all projects &rarr;</a>
      </div>

      <div class="featured-work__controls">
        <span class="featured-work__count" aria-live="polite" aria-atomic="true">
          <span data-current-index>01</span> / {total}
        </span>
        <div class="featured-work__nav">
          <button
            class="featured-work__nav-btn"
            type="button"
            data-nav="prev"
            aria-label="Previous project"
          >
            <span aria-hidden="true">&larr;</span>
          </button>
          <button
            class="featured-work__nav-btn"
            type="button"
            data-nav="next"
            aria-label="Next project"
          >
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
      </div>
    </div>
  </Container>

  <div class="featured-work__track" data-featured-track>
    {PROJECTS.map((project) => (
      <figure class="featured-work__item" data-featured-item>
        <div class="featured-work__frame" data-reveal-media>
          {project.type === "video" ? (
            <PlayableVideo
              poster={project.poster}
              alt={project.alt}
              aspectRatio="16 / 9"
              muxPlaybackId={project.muxPlaybackId}
            />
          ) : (
            <ResponsiveImage
              src={project.image}
              alt="Placeholder. Real project photography will replace this image."
              widths={[600, 900, 1200, 1600]}
              sizes="(min-width: 900px) 80vw, 90vw"
              loading="lazy"
            />
          )}
        </div>
        <figcaption class="featured-work__caption">
          <span class="featured-work__caption-label">{project.label ?? "Project placeholder"}</span>
          <span class="featured-work__caption-location">
            {project.location ?? "Photo and details coming soon"}
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .featured-work {
    /* Asymmetric on purpose: top is tightened (the "too much empty
       black space below the navbar" complaint), bottom keeps the
       original space-9 rhythm matching the sections around it. */
    padding-top: var(--space-7);
    padding-bottom: var(--space-9);
    overflow: hidden;
  }

  .featured-work__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--space-6);
  }

  .featured-work__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
  }

  .featured-work__more {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-border-gold);
  }

  .featured-work__more:hover {
    border-bottom-color: var(--color-accent);
  }

  .featured-work__controls {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-shrink: 0;
  }

  .featured-work__count {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted-inverse);
  }

  .featured-work__count [data-current-index] {
    color: var(--color-gold);
  }

  .featured-work__nav {
    display: none;
    gap: var(--space-2);
  }

  .featured-work__nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-inverse);
    color: var(--color-text-inverse);
    background: transparent;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .featured-work__nav-btn:hover,
  .featured-work__nav-btn:focus-visible {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .featured-work__nav-btn[disabled] {
    opacity: 0.3;
    pointer-events: none;
  }

  /* Native horizontal scroll-snap - no carousel library, no dots. The
     track bleeds full-bleed past the container's right edge so the next
     project peeks into view; padding-inline uses the same custom property
     as Container so the first frame's left edge lines up with the intro
     row above it. */
  .featured-work__track {
    display: flex;
    gap: var(--space-5);
    padding-inline: var(--container-padding);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .featured-work__track::-webkit-scrollbar {
    display: none;
  }

  .featured-work__item {
    flex: 0 0 90vw;
    scroll-snap-align: start;
  }

  .featured-work__frame {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .featured-work__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* PlayableVideo sets its own aspect-ratio inline on its root element
     (so it can size itself correctly everywhere else it's used), which
     would otherwise fight this frame's own sizing (aspect-ratio at
     mobile, an explicit clamped height at desktop - see below). An
     inline style can only be overridden with !important; height:100%
     here makes the video fill whatever height the frame itself has
     already settled on, same as the photo entries above. */
  .featured-work__frame :global(.playable-video) {
    aspect-ratio: auto !important;
    height: 100% !important;
  }

  .featured-work__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-4);
  }

  .featured-work__caption-label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }

  .featured-work__caption-location {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted-inverse);
  }

  @media (min-width: 900px) {
    .featured-work__nav {
      display: flex;
    }

    /* Narrower than the mobile 90vw, but still vw-based so the next
       project's peek scales fluidly with viewport width rather than
       being a fixed pixel sliver. */
    .featured-work__item {
      flex: 0 0 64vw;
    }

    /* An explicit clamped height, not aspect-ratio-driven from the (vw-
       based) item width above - at the old 80vw width, the 3:2 frame
       below scaled to almost full viewport height (791px at 1440px
       wide), reading as full-screen rather than one homepage section.
       Height now stays in a fixed 400-475px band regardless of item
       width or viewport size; aspect-ratio is dropped here so this
       height wins outright (the two can't both govern), and the real
       photography that replaces the placeholders is still never
       distorted - object-fit: cover (below) just crops to whatever
       ratio results. */
    .featured-work__frame {
      aspect-ratio: auto;
      height: clamp(440px, 30vw, 475px);
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-featured-track]");
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-featured-item]"));
  const counter = document.querySelector<HTMLElement>("[data-current-index]");
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-nav="prev"]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-nav="next"]');

  if (track && items.length) {
    let activeIndex = 0;

    const setActive = (index: number) => {
      activeIndex = index;
      if (counter) counter.textContent = String(index + 1).padStart(2, "0");
      prevBtn?.toggleAttribute("disabled", index === 0);
      nextBtn?.toggleAttribute("disabled", index === items.length - 1);
    };

    // Tracks which frame is most visible in the scroll track so the 01/04
    // counter and the prev/next disabled states follow native scroll and
    // swipe, not just clicks on the arrows.
    const observer = new IntersectionObserver(
      (entries) => {
        const mostVisible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!mostVisible) return;
        const index = items.indexOf(mostVisible.target as HTMLElement);
        if (index !== -1) setActive(index);
      },
      { root: track, threshold: [0.5, 0.75, 1] },
    );

    items.forEach((item) => observer.observe(item));

    const scrollToIndex = (index: number) => {
      const clamped = Math.max(0, Math.min(items.length - 1, index));
      items[clamped]?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
    };

    prevBtn?.addEventListener("click", () => scrollToIndex(activeIndex - 1));
    nextBtn?.addEventListener("click", () => scrollToIndex(activeIndex + 1));
  }
</script>
