---
/**
 * A single large real-project photo with minimal metadata - not another
 * homepage Featured Work carousel. One image, full-bleed edge to edge for
 * scale/impact, cinematic 16:9 rather than Featured Work's 3:2 so the two
 * don't read as the same device.
 *
 * Metadata is split into two restrained slots so real project data drops
 * in later without a rebuild: `meta` is a short "TYPE · LOCATION" tag
 * above the image (e.g. "Roof Replacement · Elk Grove, CA" once known),
 * `caption` is a fuller one-line description below it (type, location,
 * material). Neither should carry invented specifics before the client
 * supplies them.
 */
import Container from "./Container.astro";

interface Props {
  eyebrow: string;
  meta: string;
  image: string;
  imageAlt: string;
  caption: string;
}

const { eyebrow, meta, image, imageAlt, caption } = Astro.props;
---

<section class="project-spotlight">
  <Container>
    <p class="eyebrow project-spotlight__eyebrow">{eyebrow}</p>
    <p class="project-spotlight__meta">{meta}</p>
  </Container>

  <div class="project-spotlight__frame">
    <img src={image} alt={imageAlt} loading="lazy" />
  </div>

  <Container>
    <p class="project-spotlight__caption">{caption}</p>
  </Container>
</section>

<style>
  .project-spotlight {
    padding-block: var(--space-9);
  }

  .project-spotlight__eyebrow {
    margin-bottom: var(--space-3);
  }

  .project-spotlight__meta {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .project-spotlight__frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .project-spotlight__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-spotlight__caption {
    max-width: 62ch;
    margin-top: var(--space-4);
    font-size: var(--text-body-sm);
    color: var(--color-text-muted);
  }

  /* Full-bleed 16:9 was reading as almost another full-screen hero at
     wide desktop widths (e.g. ~810px tall at 1440px). Capping the height
     keeps the cinematic full-width feel as a strong visual moment
     without it overwhelming the page - object-fit: cover handles the
     resulting wider-than-16:9 crop gracefully. Mobile is unaffected;
     16:9 at phone widths was already a reasonable height. */
  @media (min-width: 900px) {
    .project-spotlight__frame {
      max-height: 65vh;
    }
  }
</style>
