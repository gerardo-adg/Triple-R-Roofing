---
/**
 * A single horizontal credential strip (logo + short label per
 * credential) rather than five large stacked rows with descriptions -
 * the row-per-credential layout carried real visual weight but ran very
 * tall; this reads as one compact, premium "backed by" showcase instead.
 * No cards/boxes/shadows - a thin divider between items (same language
 * as Trust's column rule) is the only separator.
 *
 * `logo` is optional - real certifying-body logos, at whatever aspect
 * ratio they actually ship in (square badges, wide horizontal lockups),
 * constrained to a shared box so a very wide logo and a square one still
 * sit at a consistent visual weight next to each other.
 *
 * `description` is accepted but intentionally unused here (kept on the
 * type/prop so callers don't need updating) - the credential name alone
 * carries enough context at this compact size; the longer copy this used
 * to show doesn't fit the showcase format.
 */
import Container from "./Container.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Credential {
  name: string;
  description: string;
  logo?: ImageMetadata;
}

interface Props {
  eyebrow: string;
  headline: string;
  intro: string;
  credentials: Credential[];
}

const { eyebrow, headline, intro, credentials } = Astro.props;
---

<section class="certifications section--inverse">
  <Container>
    <div class="certifications__intro" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="certifications__headline">{headline}</h2>
      <p class="certifications__lead">{intro}</p>
    </div>
  </Container>

  <div class="certifications__track" data-reveal>
    <div class="certifications__marquee">
      <div class="certifications__group">
        {credentials.map((credential) => (
          <div class="certifications__item">
            <div class="certifications__logo-slot">
              {credential.logo && (
                <Image
                  class="certifications__logo"
                  src={credential.logo}
                  alt=""
                  width={Math.round(120 * (credential.logo.width / credential.logo.height))}
                  height={120}
                />
              )}
            </div>
            <p class="certifications__label">{credential.name}</p>
          </div>
        ))}
      </div>
      {/* Exact duplicate of the group above, purely so the mobile marquee
          (below) has a seamless second lap to scroll into - translateX
          shifts by exactly one group-width, so this clone lands precisely
          where the first group started with no visible seam. Hidden from
          assistive tech (the real content was already announced once) and
          hidden outright on desktop, which doesn't animate. */}
      <div class="certifications__group certifications__group--clone" aria-hidden="true">
        {credentials.map((credential) => (
          <div class="certifications__item">
            <div class="certifications__logo-slot">
              {credential.logo && (
                <Image
                  class="certifications__logo"
                  src={credential.logo}
                  alt=""
                  width={Math.round(120 * (credential.logo.width / credential.logo.height))}
                  height={120}
                />
              )}
            </div>
            <p class="certifications__label">{credential.name}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .certifications {
    padding-block: var(--space-9);
  }

  .certifications__intro {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .certifications__headline {
    font-size: var(--text-h3);
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .certifications__lead {
    color: var(--color-text-muted-inverse);
  }

  /* Mobile: a slow, continuous right-to-left marquee instead of a row the
     visitor has to know to swipe - the clone group (identical content)
     sitting right after the real one means translating the whole
     `.certifications__marquee` by exactly -50% of its own width (one
     group-width) lands it precisely back on the real group's starting
     position, so the loop has no visible seam or jump. `overflow: hidden`
     here is what keeps the oversized (2x-width) marquee from widening the
     page itself. Becomes a normal, non-animated, non-scrolling row
     (evenly distributed, capped at the same width as the intro above) at
     desktop - see the min-width override below. */
  .certifications__track {
    overflow: hidden;
    padding-inline: var(--container-padding);
  }

  .certifications__marquee {
    display: flex;
    width: max-content;
    animation: certifications-marquee 30s linear infinite;
  }

  .certifications__group {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-5);
    /* Same size as the inter-item gap, so the seam between the two groups
       reads identically to every other gap in the strip - a different
       value here is the classic way a "seamless" marquee ends up with a
       visible stutter at the loop point. */
    padding-inline-end: var(--space-5);
  }

  .certifications__item {
    flex: 0 0 132px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  /* A fixed-height slot (not just a max-height on the image) - certifying-
     body logos ship at very different aspect ratios, from near-square
     badges to wide horizontal lockups (ASC's, ~7:1). Without a reserved
     slot, a wide logo renders much shorter than a square one once both
     are capped to the same max-width, which pushed its label out of line
     with the rest of the row. Centering every logo inside the same-height
     slot keeps all five labels sitting on one shared baseline regardless
     of each logo's actual proportions.
     Mobile-only height is larger than desktop's (56px vs. 44px, reset
     below): measured that a near-square badge (GAF, CertainTeed) at 44px
     rendered only 44px wide inside this 132px-wide column, leaving ~44px
     of dead black margin on each side - during the marquee's continuous
     motion that reads as a stretch of empty black between logos rather
     than a static row, where the eye has time to take in the whole row
     at once. Sizing up narrows that margin without changing desktop. */
  .certifications__logo-slot {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .certifications__logo {
    height: auto;
    width: auto;
    max-height: 56px;
    max-width: 124px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .certifications__label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1.35;
    color: var(--color-text-inverse);
  }

  @keyframes certifications-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Respect prefers-reduced-motion: stop the marquee and drop the cloned
     group, then let the one real group wrap into a plain static grid
     instead of a single unscrollable line - reduced-motion visitors get
     a clean, fully visible layout rather than a frozen mid-scroll strip
     or content clipped off past the viewport edge. */
  @media (prefers-reduced-motion: reduce) {
    /* `.certifications__marquee` has to stop being a flex container here,
       not just lose its animation - as a flex row it sizes to its child's
       full unwrapped width regardless of `width: auto`, so the group's own
       `flex-wrap` never had a constrained box to actually wrap within,
       and the oversized result overflowed the page. `display: block` (the
       same fix already used for desktop below) gives the group a real
       100%-of-viewport box to wrap inside. */
    .certifications__marquee {
      display: block;
      width: auto;
      animation: none;
    }

    .certifications__group {
      flex-wrap: wrap;
      justify-content: center;
      padding-inline-end: 0;
      row-gap: var(--space-5);
    }

    .certifications__group--clone {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .certifications__track {
      max-width: var(--container-max);
      margin-inline: auto;
      overflow: visible;
    }

    .certifications__marquee {
      display: block;
      width: auto;
      animation: none;
    }

    .certifications__group {
      display: flex;
      gap: var(--space-7);
      padding-inline-end: 0;
    }

    .certifications__group--clone {
      display: none;
    }

    .certifications__item {
      flex: 1 1 0;
      /* Thin column rule between credentials - same divider language as
         Trust's column rule - instead of a card/box around each one. */
      border-inline-start: 1px solid var(--color-border-inverse);
      padding-inline-start: var(--space-7);
    }

    .certifications__item:first-child {
      border-inline-start: none;
      padding-inline-start: 0;
    }

    /* Reset back to the original (smaller) size here - the mobile-only
       bump above is specifically for the marquee's continuous motion and
       has no reason to apply to this static, non-scrolling row. */
    .certifications__logo-slot {
      height: 44px;
    }

    .certifications__logo {
      max-height: 44px;
    }
  }
</style>
