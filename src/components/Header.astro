---
import Container from "./Container.astro";
import Button from "./Button.astro";

interface Props {
  /** Set true on pages without a dark hero underneath the nav. */
  alwaysSolid?: boolean;
}

const { alwaysSolid = false } = Astro.props;

const NAV_LINKS = [
  { label: "About", href: "/about" },
  { label: "Financing", href: "/financing" },
  { label: "Contact", href: "/contact" },
];

// Sourced from the current site's confirmed service list (Phase 1 audit).
const SERVICE_LINKS = [
  { label: "Roof Replacement", href: "/services/roof-replacement" },
  { label: "Roof Repair", href: "/services/roof-repair" },
  { label: "Tile Roofing", href: "/services/tile-roofing" },
  { label: "Gutters", href: "/services/gutters" },
  { label: "Solar Panel Cleaning", href: "/services/solar-panel-cleaning" },
  { label: "Moss Removal", href: "/services/moss-removal" },
  { label: "Insurance Claim Assistance", href: "/insurance-claims" },
];

// Sourced from public directory listings (BBB/Yelp) during the Phase 1
// audit — pending the client's explicit confirmation before launch.
const PHONE_DISPLAY = "(916) 420-5635";
const PHONE_HREF = "tel:+19164205635";
---

<header class:list={["header", alwaysSolid && "header--solid-init"]} data-header>
  <Container>
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="Triple R Roofing home">
      <svg class="header__mark" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">
        <circle cx="32" cy="32" r="30.5" fill="none" stroke="var(--color-gold)" stroke-width="3" />
        <rect x="17" y="21" width="30" height="5.5" fill="currentColor" />
        <rect x="29.25" y="21" width="5.5" height="24" fill="currentColor" />
      </svg>
      <span class="header__wordmark">Triple R Roofing</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__nav-list">
        <li class="header__nav-item header__nav-item--dropdown">
          <button class="header__nav-link header__nav-trigger" aria-haspopup="true">
            Services
          </button>
          <div class="header__dropdown">
            <ul>
              {SERVICE_LINKS.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        </li>
        {NAV_LINKS.map((link, i) => (
          <li class="header__nav-item" style={`--i: ${i + 1}`}>
            <a class="header__nav-link" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <Button variant="primary" href="/contact" class="header__cta" inverse={!alwaysSolid}>
        Free Estimate
      </Button>
      <button
        class="header__toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">Open menu</span>
        <span class="header__toggle-line"></span>
        <span class="header__toggle-line"></span>
      </button>
    </div>
  </div>
  </Container>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label="Site menu" inert>
  <Container>
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <a href="/" class="header__logo header__logo--mobile" aria-label="Triple R Roofing home">
        <svg class="header__mark" viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
          <circle cx="32" cy="32" r="30.5" fill="none" stroke="var(--color-gold)" stroke-width="3" />
          <rect x="17" y="21" width="30" height="5.5" fill="currentColor" />
          <rect x="29.25" y="21" width="5.5" height="24" fill="currentColor" />
        </svg>
        <span class="header__wordmark">Triple R Roofing</span>
      </a>
      <button class="header__toggle header__toggle--close" data-menu-close aria-label="Close menu">
        <span class="header__toggle-line"></span>
        <span class="header__toggle-line"></span>
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobile">
      <ul class="mobile-menu__list">
        <li style="--i: 0">
          <details class="mobile-menu__disclosure">
            <summary>
              <span class="mobile-menu__index">01</span>
              <span>Services</span>
            </summary>
            <ul>
              {SERVICE_LINKS.map((link) => (
                <li><a href={link.href} data-menu-link>{link.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
        {NAV_LINKS.map((link, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={link.href} data-menu-link>
              <span class="mobile-menu__index">{String(i + 2).padStart(2, "0")}</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__footer">
      <a class="mobile-menu__phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <Button variant="primary" href="/contact" inverse>Request a Free Estimate</Button>
    </div>
  </div>
  </Container>
</div>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    height: var(--nav-height);
    color: var(--color-text-inverse);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  .header--scrolled,
  .header--solid-init {
    color: var(--color-text);
    background: var(--color-bg-raised);
    border-bottom-color: var(--color-border);
  }

  .header--menu-open {
    color: var(--color-text-inverse);
    background: transparent;
    border-bottom-color: transparent;
  }

  /*
    The CTA is rendered with `inverse` styling once, at build time, so it
    reads correctly over the dark hero. Scroll state is a runtime class on
    <header>, not an Astro prop, so it can't re-render the button — instead
    the scrolled state overrides the button's own (child-component) classes
    directly via :global(), the same way any header-specific button
    treatment would.
  */
  .header--scrolled :global(.header__cta.btn--inverse) {
    background: var(--color-charcoal);
    border-color: var(--color-charcoal);
    color: var(--color-paper);
  }

  .header--scrolled :global(.header__cta.btn--inverse:hover) {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-charcoal);
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  @media (min-width: 481px) {
    .header__inner {
      gap: var(--space-6);
    }
  }

  /* Icon-only mark below 481px — the wordmark plus a CTA and toggle
     doesn't fit comfortably in one row at phone widths. The link still
     carries its aria-label for assistive tech. */
  @media (max-width: 480px) {
    .header__wordmark {
      display: none;
    }
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
  }

  .header__wordmark {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__nav {
    flex: 1;
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  .header__nav-item {
    position: relative;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 60ms);
  }

  .header__nav-link,
  .header__nav-trigger {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-normal);
  }

  .header__nav-trigger {
    display: inline-flex;
    cursor: default;
  }

  /* Dark panel, thin gold top edge — integrated into the black/gold
     interface rather than a disconnected white rectangle. */
  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-4));
    left: 50%;
    transform: translateX(-50%);
    min-width: 240px;
    padding: var(--space-3) 0;
    background: var(--color-charcoal-raised);
    border: 1px solid var(--color-border-inverse);
    border-top: 2px solid var(--color-gold);
    color: var(--color-text-inverse);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility var(--duration-fast);
  }

  .header__nav-item--dropdown:hover .header__dropdown,
  .header__nav-item--dropdown:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown ul {
    list-style: none;
  }

  .header__dropdown li a {
    display: block;
    padding: var(--space-2) var(--space-5);
    font-size: var(--text-body-sm);
    white-space: nowrap;
    text-decoration: none;
  }

  .header__dropdown li a:hover {
    color: var(--color-accent);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: 260ms;
    --btn-padding-y: var(--space-2);
    --btn-padding-x: var(--space-3);
    --btn-font-size: 0.6875rem;
  }

  .header__phone {
    display: none;
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
  }

  .header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
  }

  .header__toggle-line {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-standard), opacity var(--duration-fast);
  }

  .header--menu-open .header__toggle:not(.header__toggle--close) .header__toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .header--menu-open .header__toggle:not(.header__toggle--close) .header__toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .header__toggle--close .header__toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .header__toggle--close .header__toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ---- Mobile full-screen menu ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--color-charcoal);
    color: var(--color-text-inverse);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard),
      visibility var(--duration-base);
  }

  .mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  /* Container's own root div has no intrinsic height — it has to be told
     to fill the full-height overlay before .mobile-menu__inner's own
     height: 100% means anything. */
  .mobile-menu :global(.container) {
    height: 100%;
  }

  .mobile-menu__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    flex-shrink: 0;
  }

  .mobile-menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    overflow-y: auto;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .mobile-menu__list > li {
    border-top: 1px solid var(--color-border-gold);
    opacity: 0;
    transform: translateY(10px);
  }

  .mobile-menu__list > li:last-child {
    border-bottom: 1px solid var(--color-border-gold);
  }

  .mobile-menu.is-open .mobile-menu__list > li {
    animation: menu-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 55ms + 80ms);
  }

  .mobile-menu a {
    text-decoration: none;
  }

  /* Large, confident, uppercase sans — replaces the previous serif
     treatment entirely. Numbering gives the list structure/authority
     without adding decoration for its own sake. */
  .mobile-menu__list > li > a,
  .mobile-menu__disclosure summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu__index {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--color-gold);
    letter-spacing: var(--tracking-normal);
  }

  .mobile-menu__disclosure summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__disclosure summary::after {
    content: "";
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-gold);
    border-bottom: 2px solid var(--color-gold);
    transform: rotate(45deg);
    transition: transform var(--duration-fast) var(--ease-standard);
    margin-left: auto;
  }

  .mobile-menu__disclosure[open] summary::after {
    transform: rotate(-135deg);
  }

  .mobile-menu__disclosure ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    padding-left: calc(var(--text-body-sm) + var(--space-4));
    list-style: none;
  }

  .mobile-menu__disclosure ul a {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted-inverse);
  }

  .mobile-menu__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-inverse);
    flex-shrink: 0;
  }

  .mobile-menu__phone {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-h6);
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }

    .header__phone {
      display: inline-block;
    }

    .header__toggle {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");

  // Transparent-over-hero -> solid-on-scroll.
  if (header) {
    let ticking = false;
    const SCROLL_THRESHOLD = 24;

    const updateScrollState = () => {
      header.classList.toggle("header--scrolled", window.scrollY > SCROLL_THRESHOLD);
      ticking = false;
    };

    updateScrollState();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateScrollState);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  // Full-screen mobile menu.
  if (header && toggle && menu) {
    const openMenu = () => {
      menu.classList.add("is-open");
      menu.removeAttribute("inert");
      header.classList.add("header--menu-open");
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    };

    const closeMenu = () => {
      menu.classList.remove("is-open");
      menu.setAttribute("inert", "");
      header.classList.remove("header--menu-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      toggle.focus();
    };

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.contains("is-open");
      isOpen ? closeMenu() : openMenu();
    });

    closeBtn?.addEventListener("click", closeMenu);

    menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.classList.contains("is-open")) {
        closeMenu();
      }
    });
  }
</script>
