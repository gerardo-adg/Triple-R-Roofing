---
import Container from "./Container.astro";
import Button from "./Button.astro";
import { Image } from "astro:assets";
import logoMark from "../assets/media/logo-triple-r-roofing.webp";

interface Props {
  /** Set true on pages without a dark hero underneath the nav. */
  alwaysSolid?: boolean;
}

const { alwaysSolid = false } = Astro.props;

const NAV_LINKS = [
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Financing", href: "/financing" },
  { label: "Contact", href: "/contact" },
];

// Every confirmed, live service, grouped to match /services' own
// category structure exactly - single source of truth reused for both
// the desktop mega-menu (grouped into 3 columns below) and the mobile
// disclosure (rendered as one flat list of these 4 groups in order).
const SERVICE_GROUPS = [
  {
    name: "Roofing",
    items: [
      { label: "Roof Replacement", href: "/services/roof-replacement" },
      { label: "Roof Repair", href: "/services/roof-repair" },
      { label: "Tile Roofing", href: "/services/tile-roofing" },
      { label: "Flat Roofing", href: "/services/flat-roofing" },
    ],
  },
  {
    name: "Roof Care",
    items: [
      { label: "Roof Maintenance & Leak Prevention", href: "/services/roof-maintenance" },
      { label: "Roof Rejuvenation", href: "/services/roof-rejuvenation" },
      { label: "Roof Certifications", href: "/services/roof-certifications" },
      { label: "Moss Removal", href: "/services/moss-removal" },
    ],
  },
  {
    name: "Gutters",
    items: [{ label: "Gutters", href: "/services/gutters" }],
  },
  {
    name: "Solar",
    items: [
      { label: "Solar Panel Cleaning", href: "/services/solar-panel-cleaning" },
      { label: "Roofing + Solar", href: "/services/roofing-solar" },
    ],
  },
];

// Desktop-only grouping of the 4 categories above into 3 columns -
// Gutters and Solar share a column since each is short on its own.
const SERVICE_COLUMNS = [[SERVICE_GROUPS[0]], [SERVICE_GROUPS[1]], [SERVICE_GROUPS[2], SERVICE_GROUPS[3]]];

// Confirmed correct by the client directly.
const PHONE_DISPLAY = "(916) 420-5635";
const PHONE_HREF = "tel:+19164205635";
---

<header class:list={["header", alwaysSolid && "header--solid-init"]} data-header>
  <Container>
  <div class="header__inner">
    <a href="/" class="header__logo" aria-label="Triple R Roofing home">
      <Image class="header__mark" src={logoMark} alt="" width={39} height={34} densities={[2, 3]} />
      <span class="header__wordmark">Triple R Roofing</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__nav-list">
        <li class="header__nav-item header__nav-item--dropdown">
          <button class="header__nav-link header__nav-trigger" aria-haspopup="true">
            Services
          </button>
          <div class="header__dropdown header__dropdown--mega">
            <div class="header__dropdown-columns">
              {SERVICE_COLUMNS.map((column) => (
                <div class="header__dropdown-column">
                  {column.map((group) => (
                    <div class="header__dropdown-group">
                      <p class="header__dropdown-label">{group.name}</p>
                      <ul>
                        {group.items.map((item) => (
                          <li><a href={item.href}>{item.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              ))}
            </div>
            <a href="/services" class="header__dropdown-viewall">View All Services &rarr;</a>
          </div>
        </li>
        {NAV_LINKS.map((link, i) => (
          <li class="header__nav-item" style={`--i: ${i + 1}`}>
            <a class="header__nav-link" href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <Button variant="primary" href="/contact" class="header__cta" inverse>
        Free Estimate
      </Button>
      <button
        class="header__toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="visually-hidden">Open menu</span>
        <span class="header__toggle-line"></span>
        <span class="header__toggle-line"></span>
      </button>
    </div>
  </div>
  </Container>
</header>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label="Site menu" inert>
  <Container>
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <a href="/" class="header__logo header__logo--mobile" aria-label="Triple R Roofing home">
        <Image class="header__mark" src={logoMark} alt="" width={35} height={30} densities={[2, 3]} />
        <span class="header__wordmark">Triple R Roofing</span>
      </a>
      <button class="header__toggle header__toggle--close" data-menu-close aria-label="Close menu">
        <span class="header__toggle-line"></span>
        <span class="header__toggle-line"></span>
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobile">
      <ul class="mobile-menu__list">
        <li style="--i: 0">
          <details class="mobile-menu__disclosure">
            <summary>
              <span class="mobile-menu__index">01</span>
              <span>Services</span>
            </summary>
            <div class="mobile-menu__groups">
              {SERVICE_GROUPS.map((group) => (
                <div class="mobile-menu__group">
                  <p class="mobile-menu__group-label">{group.name}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li><a href={item.href} data-menu-link>{item.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <a href="/services" class="mobile-menu__viewall" data-menu-link>View All Services &rarr;</a>
            </div>
          </details>
        </li>
        {NAV_LINKS.map((link, i) => (
          <li style={`--i: ${i + 1}`}>
            <a href={link.href} data-menu-link>
              <span class="mobile-menu__index">{String(i + 2).padStart(2, "0")}</span>
              <span>{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__footer">
      <a class="mobile-menu__phone" href={PHONE_HREF}>{PHONE_DISPLAY}</a>
      <Button variant="primary" href="/contact" inverse>Get a Free Estimate</Button>
    </div>
  </div>
  </Container>
</div>

<style>
  .header {
    /* `fixed` (not `sticky`) used to pin this to the viewport, but iOS
       Safari visibly glitches a fixed-position element during the ~1s
       window its address bar auto-collapses after load on a tall page -
       a gray/white tear flashes across the header and icons briefly drop
       out mid-transition, confirmed from a screen recording of the live
       site. `sticky` elements are normal in-flow boxes the browser
       repaints along with the rest of scrollable content instead of as
       an independently-composited layer, which is what avoids the glitch
       - but sticky still occupies its own nav-height of flow space, so
       the negative margin below pulls the very next element up to
       overlap it, reproducing the old "transparent floating bar over the
       hero" look with no layout change required anywhere else (every
       other page already adds its own padding-top: nav-height to clear
       this bar, exactly as it did when the bar was `fixed`). */
    position: sticky;
    top: 0;
    margin-bottom: calc(-1 * var(--nav-height));
    z-index: var(--z-nav);
    height: var(--nav-height);
    /* Container (a shared component used all over the site) has no
       height of its own, so without this the row inside it collapses to
       its content's height and sits flush at the top of this fixed
       84px bar instead of filling/centering within it - invisible
       against a transparent background, obvious once the header goes
       solid on scroll. Centering here (not by giving Container a height)
       keeps the fix scoped to the header only. */
    display: flex;
    align-items: center;
    color: var(--color-text-inverse);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      color var(--duration-base) var(--ease-standard);
  }

  /* Solid state now matches the footer's own dark surface (--color-bg-
     inverse/--color-text-inverse) instead of a light bar - reads as one
     continuous black/gold interface with the transparent-over-hero state
     instead of flashing white on scroll. */
  .header--scrolled,
  .header--solid-init {
    color: var(--color-text-inverse);
    background: var(--color-bg-inverse);
    border-bottom-color: var(--color-border-inverse);
  }

  .header--menu-open {
    color: var(--color-text-inverse);
    background: transparent;
    border-bottom-color: transparent;
  }

  .header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  @media (min-width: 481px) {
    .header__inner {
      gap: var(--space-6);
    }
  }

  /* Icon-only mark below 481px — the wordmark plus a CTA and toggle
     doesn't fit comfortably in one row at phone widths. The link still
     carries its aria-label for assistive tech. Since the mark is the
     only visible brand element at this width (no adjacent wordmark),
     it's sized up rather than kept at the same size used alongside
     text. */
  @media (max-width: 480px) {
    .header__wordmark {
      display: none;
    }

    .header__mark {
      width: 52px;
      height: 45px;
    }
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
  }

  /* A solid circular badge next to all-caps text reads as sitting lower
     than the text even when the two are exactly box-centered (confirmed
     via computed bounding boxes) - a common optical-alignment mismatch
     between geometric marks and text. This nudge is deliberate, not a
     layout fix. */
  .header__mark {
    transform: translateY(-2px);
  }

  .header__wordmark {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .header__nav {
    flex: 1;
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
  }

  .header__nav-item {
    position: relative;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 60ms);
  }

  .header__nav-link,
  .header__nav-trigger {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
    letter-spacing: var(--tracking-normal);
  }

  .header__nav-trigger {
    display: inline-flex;
    cursor: default;
  }

  /* Dark panel, thin gold top edge — integrated into the black/gold
     interface rather than a disconnected white rectangle. Anchored to
     the trigger's left edge (not centered) now that the mega-menu is
     wide enough that centering could push it past the viewport edge on
     narrower desktop widths. */
  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-4));
    left: 0;
    background: var(--color-charcoal-raised);
    border: 1px solid var(--color-border-inverse);
    border-top: 2px solid var(--color-gold);
    color: var(--color-text-inverse);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility var(--duration-fast);
  }

  .header__nav-item--dropdown:hover .header__dropdown,
  .header__nav-item--dropdown:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown--mega {
    min-width: 640px;
    padding: var(--space-6);
  }

  .header__dropdown-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-7);
  }

  .header__dropdown-group {
    margin-bottom: var(--space-6);
  }

  .header__dropdown-group:last-child {
    margin-bottom: 0;
  }

  .header__dropdown-label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .header__dropdown-column ul {
    list-style: none;
  }

  .header__dropdown-column li a {
    display: block;
    padding-block: var(--space-2);
    font-size: var(--text-body-sm);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .header__dropdown-column li a:hover,
  .header__dropdown-column li a:focus-visible {
    color: var(--color-gold);
  }

  .header__dropdown-viewall {
    display: block;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-inverse);
    text-align: center;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .header__dropdown-viewall:hover,
  .header__dropdown-viewall:focus-visible {
    color: var(--color-text-inverse);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    opacity: 0;
    animation: nav-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: 260ms;
    --btn-padding-y: var(--space-2);
    --btn-padding-x: var(--space-3);
    --btn-font-size: 0.6875rem;
  }

  .header__phone {
    display: none;
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
  }

  .header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
  }

  .header__toggle-line {
    display: block;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-standard), opacity var(--duration-fast);
  }

  .header--menu-open .header__toggle:not(.header__toggle--close) .header__toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .header--menu-open .header__toggle:not(.header__toggle--close) .header__toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .header__toggle--close .header__toggle-line:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .header__toggle--close .header__toggle-line:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ---- Mobile full-screen menu ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    background: var(--color-charcoal);
    color: var(--color-text-inverse);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    touch-action: pan-y;
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard),
      visibility var(--duration-base);
  }

  .mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  /* Container's own root div has no intrinsic height — it has to be told
     to fill the full-height overlay before .mobile-menu__inner's own
     height: 100% means anything. */
  .mobile-menu :global(.container) {
    height: 100%;
  }

  .mobile-menu__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-5) calc(var(--space-6) + env(safe-area-inset-bottom));
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    flex-shrink: 0;
  }

  .mobile-menu__nav {
    flex: 1;
    display: flex;
    overflow-x: hidden;
    overflow-y: auto;
    /* Without this, touch drags are free-form (the browser's default
       lets a scrollable element pan diagonally/sideways even with
       nothing to actually scroll horizontally into), which is what
       reads as "loose"/not locked in place. pan-y restricts touch
       gestures here to vertical only. */
    touch-action: pan-y;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* margin-block: auto (not align-items: center on the scroll
       container) centers the list when it's short enough to fit, but
       degrades to top-aligned once expanding "Services" makes it taller
       than the available space - auto margins collapse to 0 when there's
       no free space to absorb. align-items: center on an overflow: auto
       container instead centers an oversized child by pushing part of
       its top above the reachable scroll range, making it unscrollable
       into view - that's what was cutting the expanded list off. */
    margin-block: auto;
  }

  .mobile-menu__list > li {
    border-top: 1px solid var(--color-border-gold);
    opacity: 0;
    transform: translateY(10px);
  }

  .mobile-menu__list > li:last-child {
    border-bottom: 1px solid var(--color-border-gold);
  }

  .mobile-menu.is-open .mobile-menu__list > li {
    animation: menu-item-in var(--duration-base) var(--ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 55ms + 80ms);
  }

  .mobile-menu a {
    text-decoration: none;
  }

  /* Large, confident, uppercase sans — replaces the previous serif
     treatment entirely. Numbering gives the list structure/authority
     without adding decoration for its own sake. */
  .mobile-menu__list > li > a,
  .mobile-menu__disclosure summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  .mobile-menu__index {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--color-gold);
    letter-spacing: var(--tracking-normal);
  }

  .mobile-menu__disclosure summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__disclosure summary::after {
    content: "";
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-gold);
    border-bottom: 2px solid var(--color-gold);
    transform: rotate(45deg);
    transition: transform var(--duration-fast) var(--ease-standard);
    margin-left: auto;
  }

  .mobile-menu__disclosure[open] summary::after {
    transform: rotate(-135deg);
  }

  /* ---- Mobile Services groups - category labels break the 11 links
     into 4 scannable clusters instead of one long list. Same
     typographic language as the desktop mega-menu's column labels. ---- */
  .mobile-menu__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: var(--space-4);
    padding-left: calc(var(--text-body-sm) + var(--space-4));
  }

  .mobile-menu__group-label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  /* Tighter than the space between groups (.mobile-menu__groups' own
     gap) - shortens the total scroll length a little without the
     category separations losing their visual distinctness. */
  .mobile-menu__group ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
  }

  .mobile-menu__group ul a {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted-inverse);
  }

  .mobile-menu__viewall {
    display: inline-block;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .mobile-menu__footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-inverse);
    flex-shrink: 0;
  }

  .mobile-menu__phone {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--text-h6);
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }

    .header__phone {
      display: inline-block;
    }

    .header__toggle {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const menuLinks = document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");

  // Transparent-over-hero -> solid-on-scroll.
  if (header) {
    let ticking = false;
    const SCROLL_THRESHOLD = 24;

    const updateScrollState = () => {
      header.classList.toggle("header--scrolled", window.scrollY > SCROLL_THRESHOLD);
      ticking = false;
    };

    updateScrollState();
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          requestAnimationFrame(updateScrollState);
          ticking = true;
        }
      },
      { passive: true }
    );
  }

  // Full-screen mobile menu.
  if (header && toggle && menu) {
    const openMenu = () => {
      menu.classList.add("is-open");
      menu.removeAttribute("inert");
      header.classList.add("header--menu-open");
      toggle.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    };

    const closeMenu = () => {
      menu.classList.remove("is-open");
      menu.setAttribute("inert", "");
      header.classList.remove("header--menu-open");
      toggle.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      toggle.focus();
    };

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.contains("is-open");
      isOpen ? closeMenu() : openMenu();
    });

    closeBtn?.addEventListener("click", closeMenu);

    menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.classList.contains("is-open")) {
        closeMenu();
      }
    });
  }
</script>
