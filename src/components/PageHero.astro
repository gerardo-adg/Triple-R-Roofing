---
/**
 * Interior-page hero - the shared header for every non-homepage page
 * (service pages, About, Contact, Financing, Projects, etc.).
 *
 * Deliberately not a scaled-down copy of the homepage Hero: no video, no
 * scroll-driven media transform (that stays a homepage-only signature
 * interaction), and a real breadcrumb instead of a second eyebrow. It
 * still uses the same dark/scrim/inverse-type visual language as the
 * homepage Hero so the two read as the same design system at different
 * volumes, not two unrelated header styles.
 */
import Container from "./Container.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumbs: Crumb[];
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  breadcrumbs,
  image = "/media/placeholder-page-hero.svg",
  imageAlt = "",
} = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
  </div>
  <div class="page-hero__scrim" aria-hidden="true"></div>

  <Container>
    <div class="page-hero__content">
      <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
        <ol>
          {breadcrumbs.map((crumb, i) => {
            const isLast = i === breadcrumbs.length - 1;
            return (
              <li>
                {crumb.href && !isLast ? (
                  <a href={crumb.href}>{crumb.label}</a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
                {!isLast && (
                  <span class="page-hero__breadcrumb-sep" aria-hidden="true">/</span>
                )}
              </li>
            );
          })}
        </ol>
      </nav>

      <h1 class="page-hero__headline">{title}</h1>

      {description && <p class="page-hero__description">{description}</p>}
    </div>
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(320px, 42vh, 460px);
    overflow: hidden;
    background: var(--color-charcoal);
    color: var(--color-text-inverse);
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Stronger and simpler than the homepage Hero's scrim - this box is much
     shorter, so there's less room for a gradual atmospheric fade, and the
     content sits close to the bottom edge throughout. */
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(10 10 10 / 82%) 0%,
      rgb(10 10 10 / 55%) 45%,
      rgb(10 10 10 / 30%) 100%
    );
  }

  .page-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: calc(var(--nav-height) + var(--space-6));
    padding-bottom: var(--space-7);
  }

  /* Tighter bottom spacing below ~900px - the space-7 (48px) gap under
     the description read as more empty space than the shorter mobile
     headline/description block needed. Desktop proportions untouched. */
  @media (max-width: 899px) {
    .page-hero {
      min-height: clamp(280px, 40vh, 460px);
    }

    .page-hero__content {
      padding-bottom: var(--space-5);
    }
  }

  .page-hero__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-4);
  }

  .page-hero__breadcrumb li {
    display: inline-flex;
    align-items: center;
  }

  .page-hero__breadcrumb a,
  .page-hero__breadcrumb span {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .page-hero__breadcrumb a {
    color: var(--color-text-muted-inverse);
  }

  .page-hero__breadcrumb a:hover {
    color: var(--color-gold);
  }

  .page-hero__breadcrumb span[aria-current] {
    color: var(--color-gold);
  }

  .page-hero__breadcrumb-sep {
    margin-inline: var(--space-2);
    color: var(--color-text-muted-inverse);
  }

  /* Deliberately quieter than the homepage Hero's headline: title case
     rather than uppercase, and a meaningfully smaller scale - this page
     establishes context, it doesn't need to shout. */
  .page-hero__headline {
    color: var(--color-text-inverse);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
    line-height: 1.02;
  }

  .page-hero__description {
    max-width: 52ch;
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-text-muted-inverse);
  }
</style>
