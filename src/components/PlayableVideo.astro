---
/**
 * A watchable, sound-on video (a testimonial/story clip) - architecturally
 * distinct from LazyVideo, which is built for decorative, muted, looped,
 * autoplaying background media. This component:
 *
 * - never autoplays, with or without sound
 * - shows a poster and a play affordance until the visitor clicks
 * - only then creates a real <video> (or <mux-player>, once a Mux
 *   playback ID exists) with native controls and plays it with sound,
 *   which browsers allow because it follows a direct user gesture
 * - accepts `src` or `muxPlaybackId` so swapping in a cleaner export
 *   later is a one-line prop change, not a rebuild
 * - `poster` accepts either a locally-imported image (goes through
 *   ResponsiveImage/astro:assets, same as every other photo on the site)
 *   or a plain remote URL string - for a Mux-hosted playback ID, that's
 *   normally a frame pulled straight from the video itself via Mux's own
 *   thumbnail image API (https://docs.mux.com/guides/get-images-from-a-video),
 *   which already supports width/format query params, so there's no need
 *   to route it through Astro's local image pipeline too.
 *
 * Not subject to the reduced-motion autoplay suppression that governs
 * Hero/decorative video, since nothing plays until the visitor asks it to.
 */
import ResponsiveImage from "./ResponsiveImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  poster: ImageMetadata | string;
  alt: string;
  src?: string;
  muxPlaybackId?: string;
  aspectRatio?: string;
  class?: string;
}

const { poster, alt, src, muxPlaybackId, aspectRatio = "9 / 16", class: className } =
  Astro.props;

const isRemotePoster = typeof poster === "string";
// Mux thumbnail URLs already carry `?time=...`; append `&width=W` per
// candidate so the browser can still pick an appropriately-sized file
// instead of always downloading whatever the base URL happens to return.
const remoteWidths = [480, 768, 1024];
const remoteSrcset = isRemotePoster
  ? remoteWidths.map((w) => `${poster}&width=${w} ${w}w`).join(", ")
  : undefined;
---

<div
  class:list={["playable-video", className]}
  style={`aspect-ratio: ${aspectRatio};`}
  data-playable-video
  data-src={src}
  data-mux-id={muxPlaybackId}
>
  {isRemotePoster ? (
    <img
      class="playable-video__poster"
      src={`${poster}&width=768`}
      srcset={remoteSrcset}
      sizes="(min-width: 900px) 30vw, 90vw"
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <ResponsiveImage
      class="playable-video__poster"
      src={poster}
      alt={alt}
      widths={[480, 768, 1024]}
      sizes="(min-width: 900px) 30vw, 90vw"
      loading="lazy"
      decoding="async"
    />
  )}
  <button class="playable-video__play" data-play-trigger aria-label={`Play video: ${alt}`}>
    <span class="playable-video__play-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <path d="M8 5v14l11-7z" fill="currentColor" />
      </svg>
    </span>
  </button>
</div>

<style>
  .playable-video {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .playable-video__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .playable-video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .playable-video__play-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;
    color: var(--color-paper);
    background: rgb(10 10 10 / 35%);
    transition:
      transform var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .playable-video__play-icon svg {
    margin-left: 3px;
  }

  .playable-video__play:hover .playable-video__play-icon,
  .playable-video__play:focus-visible .playable-video__play-icon {
    transform: scale(1.08);
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-charcoal);
  }

  .playable-video :global(.playable-video__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  const players = document.querySelectorAll<HTMLElement>("[data-playable-video]");

  // Safari (desktop and iOS) plays HLS natively in a plain <video> - no
  // player library needed at all, which also means Safari never depends
  // on the @mux/mux-player bundle loading successfully in the first place.
  const supportsNativeHls = () =>
    document.createElement("video").canPlayType("application/vnd.apple.mpegurl") !== "";

  players.forEach((container) => {
    const trigger = container.querySelector<HTMLButtonElement>("[data-play-trigger]");
    const src = container.dataset.src;
    const muxId = container.dataset.muxId;

    if (!trigger) return;

    // No source configured yet (placeholder stage) - the poster/play UI
    // stays visible for design review, but there's nothing to play.
    if (!src && !muxId) {
      trigger.setAttribute("aria-disabled", "true");
      return;
    }

    const playPlainVideo = (videoSrc: string, poster?: string) => {
      const video = document.createElement("video");
      video.src = videoSrc;
      video.controls = true;
      video.playsInline = true;
      video.autoplay = true;
      if (poster) video.poster = poster;
      video.className = "playable-video__video";
      container.innerHTML = "";
      container.appendChild(video);
      video.play().catch(() => {});
    };

    trigger.addEventListener("click", async () => {
      const poster = container.querySelector("img")?.getAttribute("src") ?? undefined;

      if (muxId && !src) {
        const hlsUrl = `https://stream.mux.com/${muxId}.m3u8`;

        if (supportsNativeHls()) {
          playPlainVideo(hlsUrl, poster);
          return;
        }

        try {
          // Bundled with the build (package.json dependency), not fetched
          // from a third-party CDN at click time - this import is still
          // lazy (a separate chunk, only requested on click), just served
          // from the same origin as the rest of the site.
          await import("@mux/mux-player");
          const player = document.createElement("mux-player") as HTMLElement;
          player.setAttribute("playback-id", muxId);
          player.setAttribute("controls", "");
          player.setAttribute("playsinline", "");
          // Without this, the click swaps the poster for mux-player's own
          // paused UI, requiring a second click on its native play button -
          // this keeps "click the play button" a single action, matching
          // the plain-<video> path, which already sets autoplay.
          player.setAttribute("autoplay", "");
          if (poster) player.setAttribute("poster", poster);
          player.className = "playable-video__video";
          container.innerHTML = "";
          container.appendChild(player);
        } catch (err) {
          // Playback should never just silently fail - log why, then fall
          // back to a plain HLS <video> rather than leaving the button
          // looking clicked-but-unresponsive.
          console.error("Mux player failed to load; falling back to a plain video element.", err);
          playPlainVideo(hlsUrl, poster);
        }
        return;
      }

      playPlainVideo(src ?? "", poster);
    });
  });
</script>
