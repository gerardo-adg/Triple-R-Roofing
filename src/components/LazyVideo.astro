---
/**
 * Decorative/cinematic video with a poster-first, lazy-init loading model.
 *
 * - `hero`: initializes immediately rather than waiting on scroll (use for
 *   the one above-the-fold video on a page). If the element is currently
 *   hidden by CSS (the mobile/desktop variant not meant for this viewport -
 *   see Hero.astro), it's skipped entirely so its video is never fetched.
 * - Everything else waits for an IntersectionObserver to bring it near the
 *   viewport before a source is ever assigned, and pauses once it scrolls
 *   significantly out of view.
 * - `prefers-reduced-motion: reduce` skips video entirely — the poster is
 *   the whole experience for those users, not a fallback bolted on after.
 * - A Mux-hosted source renders as <mux-video> (this package's sibling to
 *   @mux/mux-player, used elsewhere for click-to-play videos), not a plain
 *   <video src="*.m3u8">: only Safari can play HLS natively through a bare
 *   <video> tag, so Chrome/Firefox would otherwise silently show the poster
 *   forever. <mux-video> handles that branch internally, with no visible
 *   player UI, same as a native element. `src` remains for a direct
 *   progressive-mp4 fallback when there's no Mux asset at all. Neither is
 *   required yet — the poster alone is a valid, complete state.
 * - `poster` accepts either a locally-imported image (goes through
 *   ResponsiveImage/astro:assets) or a remote URL string - a Mux thumbnail
 *   (https://image.mux.com/<id>/thumbnail.jpg?time=N) doesn't need or
 *   benefit from Astro's local image pipeline, same reasoning as
 *   PlayableVideo's own isRemotePoster handling.
 */
import ResponsiveImage from "./ResponsiveImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  poster: ImageMetadata | string;
  alt: string;
  src?: string;
  muxPlaybackId?: string;
  aspectRatio?: string;
  hero?: boolean;
  loop?: boolean;
  class?: string;
  /** Mux-only: skips hls.js's default guess (derived from the first
   * segment's own download, which TCP slow-start can make inaccurate) so
   * playback starts at a safe, fast-loading rendition immediately instead
   * of possibly reaching too high and stalling. Matters most for `hero`,
   * where time-to-first-frame matters more than starting at peak quality -
   * ABR still ramps it up within seconds either way. */
  initialBandwidthEstimateKbps?: number;
}

const {
  poster,
  alt,
  src,
  muxPlaybackId,
  aspectRatio = "16 / 9",
  hero = false,
  loop = true,
  class: className,
  initialBandwidthEstimateKbps,
} = Astro.props;

const isRemotePoster = typeof poster === "string";
const remoteWidths = [640, 960, 1280, 1600, 1920];
const remoteSrcset = isRemotePoster
  ? remoteWidths.map((w) => `${poster}&width=${w} ${w}w`).join(", ")
  : undefined;
---

<div
  class:list={["lazy-video", className]}
  style={`aspect-ratio: ${aspectRatio};`}
  data-lazy-video
  data-hero={hero ? "true" : undefined}
>
  {isRemotePoster ? (
    <img
      class="lazy-video__poster"
      src={`${poster}&width=1280`}
      srcset={remoteSrcset}
      sizes="100vw"
      alt={alt}
      loading={hero ? "eager" : "lazy"}
      fetchpriority={hero ? "high" : "auto"}
      decoding="async"
    />
  ) : (
    <ResponsiveImage
      class="lazy-video__poster"
      src={poster}
      alt={alt}
      widths={remoteWidths}
      sizes="100vw"
      loading={hero ? "eager" : "lazy"}
      fetchpriority={hero ? "high" : "auto"}
      decoding="async"
    />
  )}
  {muxPlaybackId ? (
    <mux-video
      class="lazy-video__video"
      muted
      loop={loop}
      playsinline
      preload={hero ? "auto" : "none"}
      aria-hidden="true"
      tabindex="-1"
      data-playback-id={muxPlaybackId}
      initial-bandwidth-estimate-kbps={initialBandwidthEstimateKbps}
    />
  ) : (
    src && (
      <video
        class="lazy-video__video"
        muted
        loop={loop}
        playsinline
        preload={hero ? "auto" : "none"}
        aria-hidden="true"
        tabindex="-1"
        data-src={src}
      />
    )
  )}
</div>

<style>
  .lazy-video {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--color-charcoal);
  }

  .lazy-video__poster,
  .lazy-video__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lazy-video__video {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out);
  }

  .lazy-video__video.is-playing {
    opacity: 1;
  }
</style>

<script>
  // Registers the <mux-video> custom element - without this import it's
  // inert markup (no playback, no HLS handling), same reason PlayableVideo
  // imports @mux/mux-player before using <mux-player>.
  import "@mux/mux-video";

  const PLAYING_CLASS = "is-playing";

  function initVideo(container: HTMLElement) {
    const video = container.querySelector<HTMLVideoElement>(".lazy-video__video");
    if (!video) return null;

    const src = video.dataset.src;
    const playbackId = video.dataset.playbackId;
    if (playbackId && !video.hasAttribute("playback-id")) {
      video.setAttribute("playback-id", playbackId);
    } else if (src && !video.src) {
      video.src = src;
    }

    video.addEventListener("playing", () => video.classList.add(PLAYING_CLASS));
    video.addEventListener("pause", () => video.classList.remove(PLAYING_CLASS));

    // <mux-video> doesn't reliably forward the `loop` attribute to its own
    // internal real <video> (confirmed in its source - it only explicitly
    // proxies a handful of properties, muted among them, not loop). It
    // does expose that internal element directly as `.nativeEl` though, so
    // setting `loop` there is genuine browser-native looping - the decoder
    // handles the restart itself with no JS/seeking involved, which is
    // what actually avoids a flash/rebuffer at the loop point. Falls back
    // to the element itself for a plain <video> (the non-Mux src case),
    // which already supports `loop` natively on its own.
    // Reads the already-rendered `loop` attribute rather than the Astro
    // prop directly - this script runs in the browser with no visibility
    // into frontmatter variables, and hasAttribute sidesteps relying on
    // any particular element's own property reflection being correct.
    const shouldLoop = video.hasAttribute("loop");
    const nativeVideo =
      (video as unknown as { nativeEl?: HTMLVideoElement }).nativeEl ?? video;
    nativeVideo.loop = shouldLoop;

    // Defensive fallback only: native `loop` suppresses the `ended` event
    // entirely, so this never fires once the above actually takes - kept
    // in case a future player version stops exposing `.nativeEl`, so
    // playback degrades to "restarts, no fancy footwork" instead of just
    // freezing on the last frame.
    video.addEventListener("ended", () => {
      if (!shouldLoop) return;
      video.currentTime = 0;
      video.play().catch(() => {});
    });

    const tryPlay = () => {
      video.play().catch(() => {
        /* Autoplay blocked — poster remains the entire experience, by design. */
      });
    };

    tryPlay();
    // <mux-video> finishes wiring up its internal player asynchronously
    // after `playback-id` is set - calling play() the instant the
    // attribute is assigned can land before that's done and gets silently
    // dropped (no error, just stuck on the poster forever). This retries
    // once the element actually reports it has a frame ready, which is a
    // no-op if the first call already succeeded.
    video.addEventListener("loadeddata", tryPlay, { once: true });

    return tryPlay;
  }

  function pauseVideo(container: HTMLElement) {
    const video = container.querySelector<HTMLVideoElement>(".lazy-video__video");
    video?.pause();
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Hero elements initialize immediately rather than waiting on scroll -
  // but only the one actually visible for the current viewport. Hero.astro
  // can render a mobile AND a desktop variant side by side (each its own
  // Mux source/poster), CSS-toggled the same way its headline already is;
  // the hidden one is skipped entirely here so its video is never fetched.
  const heroEls = document.querySelectorAll<HTMLElement>("[data-lazy-video][data-hero]");
  const heroRetries: Array<() => void> = [];
  if (!reducedMotion) {
    heroEls.forEach((el) => {
      if (getComputedStyle(el).display !== "none") {
        const retry = initVideo(el);
        if (retry) heroRetries.push(retry);
      }
    });
  }

  // Some mobile browsers block autoplay outright even with muted+playsinline
  // set correctly - iOS Low Power Mode and Chrome's Data Saver both do this,
  // and there's no way to detect either in advance. Retrying on the very
  // first touch/scroll/click anywhere on the page (not just a tap on the
  // video itself) catches it regardless of which policy caused it; a no-op
  // if the video is already playing.
  if (heroRetries.length) {
    const retryOnFirstInteraction = () => heroRetries.forEach((retry) => retry());
    document.addEventListener("touchstart", retryOnFirstInteraction, { once: true, passive: true });
    document.addEventListener("scroll", retryOnFirstInteraction, { once: true, passive: true });
    document.addEventListener("click", retryOnFirstInteraction, { once: true });
  }

  const lazyEls = document.querySelectorAll<HTMLElement>(
    "[data-lazy-video]:not([data-hero])"
  );

  if (!reducedMotion && lazyEls.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            initVideo(el);
          } else {
            pauseVideo(el);
          }
        }
      },
      { rootMargin: "200px 0px", threshold: 0 }
    );

    lazyEls.forEach((el) => observer.observe(el));
  }
</script>
