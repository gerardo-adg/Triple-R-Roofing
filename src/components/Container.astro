---
interface Props {
  /** HTML element to render. Defaults to "div". */
  as?: keyof HTMLElementTagNameMap;
  /** Narrow suits long-form reading content; wide suits full-bleed-adjacent media. */
  width?: "default" | "narrow" | "wide";
  class?: string;
}

const { as: Tag = "div", width = "default", class: className } = Astro.props;
---

<Tag class:list={["container", `container--${width}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-padding);
  }

  .container--narrow {
    max-width: 760px;
  }

  .container--wide {
    max-width: 1600px;
  }
</style>
