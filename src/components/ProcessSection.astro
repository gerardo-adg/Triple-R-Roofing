---
import Container from "./Container.astro";

// Step 4 matches verified copy from the client's existing site (the
// roof-replacement page's "final walkthrough, cleanup & warranty" bullet,
// confirmed during the Phase 1 audit). Steps 1-3 are drafted from
// generally-established facts (free estimates, quotes) but are not
// verbatim from the client's site — flagged for their confirmation,
// kept easy to edit here as plain data.
const STEPS = [
  {
    index: "01",
    title: "Contact",
    description:
      "Call or request an estimate online. We'll ask a few questions and schedule a time to come look at your roof.",
  },
  {
    index: "02",
    title: "Inspection & Quote",
    description:
      "We inspect the roof in person and give you a clear, itemized quote. No pressure, no obligation.",
  },
  {
    index: "03",
    title: "The Work",
    description:
      "Once you approve, we schedule the job and handle materials, crew, and cleanup start to finish.",
  },
  {
    index: "04",
    title: "Walkthrough",
    description:
      "We walk the finished roof with you before we consider the job done.",
  },
];
---

<section class="process">
  <Container>
    <div class="process__intro">
      <p class="eyebrow">How we work</p>
      <h2 class="process__lead">From first call to final walkthrough.</h2>
    </div>

    <div class="process__grid">
      {STEPS.map((step) => (
        <div class="process__step">
          <span class="process__index">{step.index}</span>
          <h3 class="process__title">{step.title}</h3>
          <p class="process__description">{step.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

<style>
  .process {
    padding-block: var(--space-9);
  }

  .process__intro {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .process__lead {
    font-size: var(--text-h4);
    margin-top: var(--space-3);
  }

  .process__grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
  }

  .process__step {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .process__index {
    display: block;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-3);
  }

  .process__title {
    font-size: var(--text-h6);
    margin-bottom: var(--space-2);
  }

  .process__description {
    max-width: 40ch;
  }

  @media (min-width: 900px) {
    .process__grid {
      grid-template-columns: repeat(4, 1fr);
      border-top: none;
    }

    .process__step {
      padding-block: 0;
      padding-inline: var(--space-6);
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }

    .process__step:first-child {
      padding-left: 0;
    }

    .process__step:last-child {
      padding-right: 0;
      border-right: none;
    }
  }
</style>
