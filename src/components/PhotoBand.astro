---
/**
 * A quiet, caption-free full-bleed photo strip - a breathing moment for
 * long text-only stretches on interior pages, not a content section.
 * Deliberately has no eyebrow/caption/text of any kind, so it can't turn
 * into a generic image/text split; it's a pause, not a message.
 *
 * Mobile uses a width-relative ~16:9 aspect ratio (more photographic);
 * desktop keeps a viewport-height-driven band (~160-280px) so the
 * proportions can be fine-tuned once real photography exists without
 * this note going stale - see MEDIA_PLAN.md for the intended crop.
 */
import ResponsiveImage from "./ResponsiveImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  /** "cover" (default) is right for real photography - fills the band
   * edge-to-edge, cropping whatever doesn't fit. A composed graphic
   * with precise content (e.g. a logo lockup) needs "contain" instead,
   * since cropping it isn't a loss of ambient detail, it's chopping off
   * part of a logo - this band's aspect ratio swings from ~16:9 on
   * mobile to as extreme as ~12:1 on short desktop viewports, so a
   * cover-cropped composition would need its content confined to a
   * tiny centered safe zone to survive every width, and the brief this
   * component was built for never anticipated that. */
  fit?: "cover" | "contain";
}

const { image, imageAlt, fit = "cover" } = Astro.props;
---

<div class:list={["photo-band", fit === "contain" && "photo-band--contain"]}>
  <ResponsiveImage
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1600, 2400]}
    sizes="100vw"
    loading="lazy"
    data-reveal-media
  />
</div>

<style>
  .photo-band {
    width: 100%;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .photo-band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-band--contain img {
    object-fit: contain;
  }

  /* Mobile: a width-relative aspect ratio (~16:9) rather than a
     viewport-height-driven strip - the vh-based height read as an
     unpredictably shallow sliver depending on device height. Desktop
     keeps the original vh-based band untouched. */
  @media (max-width: 899px) {
    .photo-band {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 900px) {
    .photo-band {
      height: clamp(160px, 24vh, 280px);
    }
  }
</style>
