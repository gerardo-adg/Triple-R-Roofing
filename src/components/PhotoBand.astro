---
/**
 * A quiet, caption-free full-bleed photo strip - a breathing moment for
 * long text-only stretches on interior pages, not a content section.
 * Deliberately has no eyebrow/caption/text of any kind, so it can't turn
 * into a generic image/text split; it's a pause, not a message.
 *
 * Mobile uses a width-relative ~16:9 aspect ratio (more photographic);
 * desktop keeps a viewport-height-driven band (~160-280px) so the
 * proportions can be fine-tuned once real photography exists without
 * this note going stale - see MEDIA_PLAN.md for the intended crop.
 */
interface Props {
  image: string;
  imageAlt: string;
}

const { image, imageAlt } = Astro.props;
---

<div class="photo-band">
  <img src={image} alt={imageAlt} loading="lazy" />
</div>

<style>
  .photo-band {
    width: 100%;
    overflow: hidden;
    background: var(--color-charcoal-raised);
  }

  .photo-band img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Mobile: a width-relative aspect ratio (~16:9) rather than a
     viewport-height-driven strip - the vh-based height read as an
     unpredictably shallow sliver depending on device height. Desktop
     keeps the original vh-based band untouched. */
  @media (max-width: 899px) {
    .photo-band {
      height: auto;
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 900px) {
    .photo-band {
      height: clamp(160px, 24vh, 280px);
    }
  }
</style>
