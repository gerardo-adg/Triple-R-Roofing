---
import Container from "./Container.astro";
import Button from "./Button.astro";

// Offer terms (0% APR for 24 months) confirmed by the client directly
// as the current source of truth. No down-payment claim - the client
// asked for "$0 down" to be removed site-wide. (The site previously
// said 0% interest for 3 months - the client updated the offer;
// updated everywhere it appeared.) Still flagged: the disclosure line below is
// intentionally generic (not a fabricated legal/compliance disclosure)
// and should be replaced with Wisetack's/the lender's actual required
// wording before launch.
---

<section class="financing section--inverse">
  <Container>
    <div class="financing__grid" data-reveal>
      <div class="financing__intro">
        <p class="eyebrow">Financing</p>
        <h2 class="financing__lead">Get the roof you need. Pay over time.</h2>
        <p class="financing__copy">
          Financing options available through Wisetack, including 0% APR
          for 24 months for qualified borrowers.
        </p>
        <Button variant="text" inverse href="/financing">
          Explore Financing
        </Button>
      </div>

      <div class="financing__stats">
        <div class="financing__stat financing__stat--primary">
          <p class="financing__stat-value">0%</p>
          <p class="financing__stat-label">APR for 24 months*</p>
        </div>
        <p class="financing__disclosure">
          *For qualified borrowers. Subject to credit approval. Terms
          provided by Wisetack. See the financing page for full details.
        </p>
      </div>
    </div>
  </Container>
</section>

<style>
  .financing {
    padding-block: var(--space-9);
  }

  .financing__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .financing__lead {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    font-stretch: var(--stretch-normal);
    letter-spacing: var(--tracking-normal);
    /* base.css's h1/h2 rule sets text-wrap: balance, which picks whichever
       split is most visually even — not necessarily the sentence break we
       want here, since "Get the roof you need." is longer than "Pay over
       time.". Reverting to normal (greedy-fill) wrapping so the max-width
       below actually determines the break point. */
    text-wrap: wrap;
    /* Measured against the actual rendered text (not estimated — "ch" is
       based on the "0" glyph, which runs much wider than this font's
       average character), tuned so "Get the roof you need." / "Pay over
       time." resolves to two lines at typical desktop widths. In em so it
       scales with the fluid font-size instead of one fixed pixel value. */
    max-width: 10.6em;
    margin-top: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .financing__copy {
    max-width: 46ch;
    margin-bottom: var(--space-6);
  }

  .financing__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border-inverse);
  }

  /* Mobile only: a much tighter gap after the divider and before the
     disclosure than desktop uses (row + wrap + flex-basis: 100% keeps
     the disclosure on its own full-width line below the stat) -
     desktop's own layout below is untouched. */
  @media (max-width: 899px) {
    /* Tightens the space above the divider (between "Explore Financing"
       and the border-top below), separate from .financing__stats'
       own padding-top, which controls the gap after the divider. */
    .financing__grid {
      gap: calc(var(--space-8) - 24px);
    }

    .financing__stats {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: var(--space-6);
      row-gap: var(--space-3);
      padding-top: var(--space-5);
    }

    .financing__stat {
      flex: 1 1 0;
    }

    .financing__disclosure {
      flex-basis: 100%;
    }
  }

  .financing__stat-value {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-stretch: var(--stretch-expanded);
    font-size: clamp(2.5rem, 1.9rem + 2.4vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--color-gold);
  }

  /* 0% APR for 24 months is the whole offer - the one big number. */
  .financing__stat--primary .financing__stat-value {
    font-size: clamp(3.25rem, 2.3rem + 3.6vw, 5.25rem);
  }

  .financing__stat-label {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted-inverse);
    margin-top: var(--space-1);
  }

  .financing__disclosure {
    font-size: var(--text-body-sm);
    color: var(--color-text-muted-inverse);
    max-width: 44ch;
  }

  @media (min-width: 900px) {
    .financing__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
    }

    .financing__stats {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      /* One stat now (no "$0 down" beside it) - keep the disclosure
         sitting under it instead of stretching to the column's bottom. */
      align-content: flex-start;
      gap: var(--space-5) var(--space-8);
      padding-top: 0;
      border-top: none;
      border-left: 1px solid var(--color-border-inverse);
      padding-left: var(--space-9);
    }

    .financing__stat {
      flex: 1 1 auto;
    }

    .financing__disclosure {
      flex-basis: 100%;
    }
  }
</style>
