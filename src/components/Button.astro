---
interface Props {
  variant?: "primary" | "secondary" | "text";
  href?: string;
  /** Set true when this button sits on a dark (.section--inverse) section. */
  inverse?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const {
  variant = "primary",
  href,
  inverse = false,
  type = "button",
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
const classes = ["btn", `btn--${variant}`, inverse && "btn--inverse", className]
  .filter(Boolean)
  .join(" ");
---

<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  {...href?.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <span class="btn__label"><slot /></span>
  {variant === "text" && (
    <span class="btn__arrow" aria-hidden="true">→</span>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    font-size: var(--btn-font-size, var(--text-body-sm));
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  /*
    Padding/font-size read from custom properties (with defaults) rather
    than being hardcoded, so an ancestor element can compact a specific
    button instance — e.g. the header CTA on narrow viewports — without
    needing a variant prop or fighting Astro's per-component style scoping.
  */
  .btn--primary,
  .btn--secondary {
    padding: var(--btn-padding-y, var(--space-4)) var(--btn-padding-x, var(--space-6));
    border-radius: var(--radius-none);
  }

  .btn--primary {
    background: var(--color-charcoal);
    color: var(--color-paper);
    border: 1px solid var(--color-charcoal);
  }

  .btn--primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-charcoal);
  }

  .btn--primary.btn--inverse {
    background: var(--color-paper);
    color: var(--color-charcoal);
    border-color: var(--color-paper);
  }

  .btn--primary.btn--inverse:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-charcoal);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .btn--secondary.btn--inverse {
    color: var(--color-text-inverse);
    border-color: var(--color-border-inverse);
  }

  .btn--secondary.btn--inverse:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn--text {
    padding: 0;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
    text-transform: none;
    letter-spacing: var(--tracking-normal);
  }

  .btn--text.btn--inverse {
    color: var(--color-text-inverse);
    border-color: var(--color-border-inverse);
  }

  .btn--text:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .btn--text.btn--inverse:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .btn__arrow {
    display: inline-block;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .btn--text:hover .btn__arrow {
    transform: translateX(3px);
  }
</style>
