---
/**
 * Extracted from the identical inline markup/styles already used on
 * Moss Removal and Solar Panel Cleaning, once a third page (Projects)
 * needed the same treatment - see MEDIA_PLAN.md, which flagged this
 * exact threshold. Moss Removal and Solar Panel Cleaning keep their
 * existing inline versions untouched; this component is for new uses.
 * Only ever use this for a genuine matched before/after pair for one
 * project - never a staged or generic pairing.
 */
interface Props {
  beforeImage: string;
  beforeAlt: string;
  afterImage: string;
  afterAlt: string;
}

const { beforeImage, beforeAlt, afterImage, afterAlt } = Astro.props;
---

<div class="before-after__grid">
  <figure class="before-after__frame">
    <span class="before-after__label">Before</span>
    <img src={beforeImage} alt={beforeAlt} loading="lazy" decoding="async" data-reveal-media />
  </figure>

  <div class="before-after__divider" aria-hidden="true"></div>

  <figure class="before-after__frame">
    <span class="before-after__label">After</span>
    <img src={afterImage} alt={afterAlt} loading="lazy" decoding="async" data-reveal-media />
  </figure>
</div>

<style>
  .before-after__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .before-after__frame {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .before-after__frame img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .before-after__label {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    font-size: var(--text-body-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: rgb(10 10 10 / 55%);
    padding: var(--space-1) var(--space-3);
  }

  .before-after__divider {
    display: none;
  }

  @media (min-width: 700px) {
    .before-after__grid {
      grid-template-columns: 1fr auto 1fr;
      align-items: stretch;
    }

    .before-after__divider {
      display: block;
      width: 1px;
      background: var(--color-border);
    }
  }
</style>
